---
import type { Media } from '@/types/index';
import { MOOD_META } from '@/lib/data/moodMeta';

interface Props {
  media: Media[];
}

const { media } = Astro.props;

// Build mood → count map from all media
const moodCount: Record<string, number> = {};
media.forEach(m => m.moods.forEach(mood => {
  moodCount[mood] = (moodCount[mood] ?? 0) + 1;
}));

// Sort: calm group first, then by count
const sorted = Object.entries(moodCount)
  .sort((a, b) => {
    const ga = MOOD_META[a[0]]?.group ?? 'z';
    const gb = MOOD_META[b[0]]?.group ?? 'z';
    if (ga !== gb) {
      const order = ['calm', 'energetic', 'emotional', 'textural'];
      return order.indexOf(ga) - order.indexOf(gb);
    }
    return b[1] - a[1];
  });
---

<div class="relative overflow-hidden">
  <!-- fade edges -->
  <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-r from-senses-bg to-transparent" />
  <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-8 z-10 bg-gradient-to-l from-senses-bg to-transparent" />

  <div class="flex gap-2 overflow-x-auto no-scrollbar px-4 md:px-8 py-3">
    {sorted.map(([mood, count]) => (
      <a
        href={`/mood/${mood}`}
        class="flex-shrink-0 flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-senses-surface border border-senses-border text-senses-text-3 text-xs hover:border-senses-border-2 hover:text-senses-text transition-all duration-150 capitalize whitespace-nowrap"
      >
        {mood}
        <span class="text-senses-text-3/50 text-[10px]">{count}</span>
      </a>
    ))}
  </div>
</div>
