---
import '../styles/globals.css';
import GlobalNav      from '@components/layout/GlobalNav';
import SearchOverlay   from '@components/layout/SearchOverlay';
import { InstallPrompt }   from '@/components/pwa/InstallPrompt';
import { ToastContainer }  from '@/components/ui/ToastContainer';

interface Props {
  title:        string;
  description:  string;
  canonical?:   string;
  ogImage?:     string;
  noIndex?:     boolean;
  schema?:      object;
  bodyClass?:   string;
  noFooter?:    boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noIndex = false,
  schema,
  bodyClass = '',
  noFooter = false,
} = Astro.props;

const siteUrl  = 'https://senses.dhurta.org';
const fullUrl  = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImg    = ogImage ?? `${siteUrl}/og-default.jpg`;
const fullTitle = title.includes('Senses') ? title : `${title} — Senses`;
---

<!DOCTYPE html>
<html lang="en" class="dark" data-theme="dark" data-accent="red" data-density="comfortable">
<head>
  <!-- Theme init: runs synchronously to prevent flash of wrong theme -->
  <script is:inline>
    (function(){
      try {
        var s = JSON.parse(localStorage.getItem('senses:settings') || '{}');
        var mode = s.theme || 'dark';
        var theme = mode === 'system'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : mode;
        var accent = s.accent || 'red';
        var accents = { red:'#FF2D55', blue:'#00B8FF', amber:'#FFB800', green:'#00E676', purple:'#BF5FFF', cream:'#E8E4DC' };
        var html = document.documentElement;
        html.setAttribute('data-theme', theme);
        html.setAttribute('data-accent', accent);
        html.setAttribute('data-density', s.density || 'comfortable');
        html.style.setProperty('--color-accent', accents[accent] || '#FF2D55');
        if (theme === 'dark') html.classList.add('dark');
        else html.classList.remove('dark');
      } catch(e) {}
    })();
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Primary meta -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noIndex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={fullUrl} />

  <!-- OpenGraph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={fullUrl} />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImg} />
  <meta property="og:site_name"   content="Senses" />

  <!-- Twitter -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImg} />

  <!-- PWA -->
  <link rel="manifest"     href="/manifest.json" />
  <meta name="theme-color" content="#080808" />
  <meta name="color-scheme" content="dark light" />
  <!-- Favicon: dark default, light for light-scheme browsers -->
  <link rel="icon" href="/icons/favicon-dark.png"  type="image/png" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/icons/favicon-light.png" type="image/png" media="(prefers-color-scheme: light)" />
  <link rel="icon" href="/icons/favicon-dark.png"  type="image/png" />
  <link rel="apple-touch-icon" href="/icons/icon-dark.png" />

  <!-- Structured data -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Senses",
    "url": siteUrl,
    "description": "A premium media discovery platform for visual and audio content.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": `${siteUrl}/search?q={search_term_string}` },
      "query-input": "required name=search_term_string"
    }
  })} />
</head>
<body class={`dark ${bodyClass}`}>
  <GlobalNav client:load />
  <SearchOverlay client:load />
  <InstallPrompt client:idle />
  <ToastContainer client:load />

  <main>
    <slot />
  </main>

  <!-- SW update notification -->
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').then(function(reg) {
          reg.addEventListener('updatefound', function() {
            var worker = reg.installing;
            if (!worker) return;
            worker.addEventListener('statechange', function() {
              if (worker.state === 'installed' && navigator.serviceWorker.controller) {
                var accent = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim() || '#FF2D55';
                var banner = document.createElement('div');
                banner.innerHTML = '<div style="position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%);z-index:9999;background:var(--color-surface,#1a1a1a);border:1px solid var(--color-border-2,#333);border-radius:12px;padding:10px 16px;display:flex;align-items:center;gap:12px;font-size:13px;color:var(--color-text,#ccc);box-shadow:0 8px 24px rgba(0,0,0,.5);">'
                  + '<span>Update available</span>'
                  + '<button onclick="window.location.reload()" style="background:var(--color-accent,#FF2D55);color:#fff;border:none;border-radius:8px;padding:4px 12px;cursor:pointer;font-size:12px;font-weight:600;">Reload</button>'
                  + '<button onclick="this.closest(\'div\').parentElement.remove()" style="background:none;border:none;color:var(--color-text-3,#666);cursor:pointer;font-size:18px;line-height:1;padding:0 2px;">×</button>'
                  + '</div>';
                document.body.appendChild(banner);
              }
            });
          });
        }).catch(function() {});
      });
    }
  </script>

  {!noFooter && <footer class="border-t border-senses-border mt-20 py-14 px-4 md:px-8">
    <div class="max-w-[1440px] mx-auto">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-8 mb-12">

        <!-- Brand -->
        <div class="col-span-2 sm:col-span-3 lg:col-span-2">
          <a href="/" class="brand-shimmer text-[2rem] flex items-center gap-2.5 mb-3 w-fit" style="line-height:1">
            <img src="/icons/favicon-dark.png" alt="" width={22} height={22} class="rounded-full opacity-90 flex-shrink-0 dark:block hidden" />
            <img src="/icons/favicon-light.png" alt="" width={22} height={22} class="rounded-full opacity-90 flex-shrink-0 dark:hidden block" />
            Senses
          </a>
          <p class="text-senses-text-3 text-sm leading-relaxed max-w-xs mb-3">
            A premium discovery platform for visual and audio media. Explore, collect, and feel.
          </p>
          <a href="mailto:Senses.dhurta@outlook.com" class="inline-flex items-center gap-1.5 text-xs text-senses-text-3 hover:text-senses-text transition-colors mb-4">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-3.5 h-3.5 flex-shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
            </svg>
            Senses.dhurta@outlook.com
          </a>
          <div class="flex gap-3 flex-wrap">
            <span class="inline-flex items-center gap-1.5 text-[11px] text-senses-text-3 border border-senses-border rounded-full px-3 py-1">
              <span class="w-1.5 h-1.5 rounded-full bg-senses-sight inline-block"></span>Sight
            </span>
            <span class="inline-flex items-center gap-1.5 text-[11px] text-senses-text-3 border border-senses-border rounded-full px-3 py-1">
              <span class="w-1.5 h-1.5 rounded-full bg-senses-hearing inline-block"></span>Hearing
            </span>
            <span class="inline-flex items-center gap-1.5 text-[11px] text-senses-text-3 border border-senses-border rounded-full px-3 py-1">
              <span class="w-1.5 h-1.5 rounded-full bg-senses-accent inline-block"></span>More coming
            </span>
          </div>
        </div>

        <!-- Discover -->
        <div>
          <p class="text-senses-text-3 text-xs tracking-widest uppercase mb-4 font-medium">Discover</p>
          <ul class="space-y-2.5">
            {[
              ['Gallery Wall', '/gallery'],
              ['Reels', '/discover'],
              ['Explore', '/explore'],
              ['Trending', '/trending'],
              ['Editorial', '/editorial'],
              ['Senses Radio', '/senses-radio'],
            ].map(([l, h]) => (
              <li>
                <a href={h} class="text-senses-text-3 hover:text-senses-text text-sm transition-colors inline-flex items-center gap-1.5">
                  {l}
                  {(l === 'Senses Radio') && <span class="text-[9px] text-senses-text-3 border border-senses-border rounded px-1 py-0.5">Soon</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Community -->
        <div>
          <p class="text-senses-text-3 text-xs tracking-widest uppercase mb-4 font-medium">Community</p>
          <ul class="space-y-2.5">
            {[
              ['Contests', '/contests'],
              ['Live', '/live'],
              ['Ambassadors', '/ambassadors'],
              ['Forum', '/forum'],
              ['Creators', '/creators'],
            ].map(([l, h]) => (
              <li>
                <a href={h} class="text-senses-text-3 hover:text-senses-text text-sm transition-colors inline-flex items-center gap-1.5">
                  {l}
                  <span class="text-[9px] text-senses-text-3 border border-senses-border rounded px-1 py-0.5">Soon</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Company -->
        <div>
          <p class="text-senses-text-3 text-xs tracking-widest uppercase mb-4 font-medium">Company</p>
          <ul class="space-y-2.5">
            {[
              ['About Us', '/about'],
              ['Blog', '/blog'],
              ['FAQ', '/faq'],
              ['My Senses', '/my-senses'],
              ['Settings', '/settings'],
            ].map(([l, h]) => (
              <li><a href={h} class="text-senses-text-3 hover:text-senses-text text-sm transition-colors">{l}</a></li>
            ))}
          </ul>
        </div>

        <!-- Legal + Developers -->
        <div>
          <p class="text-senses-text-3 text-xs tracking-widest uppercase mb-4 font-medium">Legal</p>
          <ul class="space-y-2.5 mb-6">
            {[
              ['Terms of Service', '/terms'],
              ['Privacy Policy', '/privacy'],
              ['License Summary', '/license'],
              ['Report Content', '/report'],
            ].map(([l, h]) => (
              <li><a href={h} class="text-senses-text-3 hover:text-senses-text text-sm transition-colors">{l}</a></li>
            ))}
          </ul>
          <p class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">Developers</p>
          <ul class="space-y-2.5">
            <li>
              <a href="/api" class="text-senses-text-3 hover:text-senses-text text-sm transition-colors inline-flex items-center gap-1.5">
                API
                <span class="text-[9px] text-senses-text-3 border border-senses-border rounded px-1 py-0.5">Soon</span>
              </a>
            </li>
          </ul>
        </div>

      </div>

      <div class="border-t border-senses-border pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="text-senses-text-3 text-xs">© 2026 Senses · All media rights belong to their respective creators · CC0 images via Pixabay · <a href="mailto:Senses.dhurta@outlook.com" class="hover:text-senses-text transition-colors">Senses.dhurta@outlook.com</a></p>
        <div class="flex gap-4 items-center flex-wrap justify-center">
          <a href="/gallery"  class="text-senses-text-3 hover:text-senses-accent text-xs transition-colors">Gallery</a>
          <a href="/settings" class="text-senses-text-3 hover:text-senses-accent text-xs transition-colors">Settings</a>
          <a href="/privacy"  class="text-senses-text-3 hover:text-senses-text text-xs transition-colors">Privacy</a>
          <a href="/terms"    class="text-senses-text-3 hover:text-senses-text text-xs transition-colors">Terms</a>
          <a href="/license"  class="text-senses-text-3 hover:text-senses-text text-xs transition-colors">License</a>
        </div>
      </div>
    </div>
  </footer>}
</body>
</html>
