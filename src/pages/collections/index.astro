---
import BaseLayout    from '@/layouts/BaseLayout.astro';
import { provider }  from '@/lib/providers';
import type { ImageData } from '@/types/index';

const collections = await provider.getCollections();

// ── Tag-based mosaic groups (SSG, no JSON import) ─────────────────────────────
const allMedia  = await provider.getMedia({});
const sightOnly = allMedia.filter(m => m.division === 'sight');

const tagMap = new Map<string, typeof sightOnly>();
for (const item of sightOnly) {
  for (const tag of (item.tags ?? [])) {
    const key = tag.toLowerCase().trim();
    if (!tagMap.has(key)) tagMap.set(key, []);
    tagMap.get(key)!.push(item);
  }
}

const SKIP_TAGS = new Set(['background', 'isolated', 'free', 'photo', 'image', 'digital', 'abstract art', 'hd', '4k', 'wallpaper', 'texture']);

const tagGroups = Array.from(tagMap.entries())
  .filter(([tag, items]) => items.length >= 4 && !SKIP_TAGS.has(tag))
  .sort((a, b) => b[1].length - a[1].length)
  .slice(0, 16)
  .map(([tag, items]) => ({
    tag,
    slug: tag.replace(/\s+/g, '-'),
    label: tag.charAt(0).toUpperCase() + tag.slice(1),
    count: items.length,
    thumbnails: items.slice(0, 4).map(m => {
      const d = m.data as ImageData | undefined;
      return d?.thumbnailUrl ?? m.thumbnail;
    }),
  }));
---

<BaseLayout
  title="Collections — Senses"
  description="Curated cross-sensory collections pairing visual and audio media into unified moods. Explore themed sets crafted by Senses."
>
  <div class="pt-[var(--nav-height)] pb-20">

    <!-- Header -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 py-10 pb-8 border-b border-senses-border mb-10">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-senses-text-3 text-xs tracking-widest uppercase mb-2">Curated Sets</p>
          <h1 class="text-display-xl text-senses-text leading-none">Collections</h1>
          <p class="text-senses-text-3 text-sm mt-3 max-w-lg">
            Themed groupings of visual and audio media curated for mood, moment, and sensory experience.
          </p>
        </div>
        <div class="flex-shrink-0 text-right hidden sm:block">
          <p class="text-senses-accent text-4xl font-light tabular-nums leading-none">{collections.length}</p>
          <p class="text-senses-text-3 text-xs uppercase tracking-widest mt-1">collections</p>
        </div>
      </div>
    </div>

    <div class="max-w-[1440px] mx-auto px-4 md:px-8">

      <!-- All Collections: unified grid -->
      {collections.length > 0 && (
        <section class="mb-16">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {collections.map(col => (
              <a
                href={`/collections/${col.slug}`}
                class="group flex flex-col rounded-2xl overflow-hidden bg-senses-surface border border-senses-border
                       hover:border-senses-accent/30 hover:shadow-[0_8px_32px_rgba(0,0,0,0.5)]
                       transition-all duration-300"
              >
                <!-- Cover image -->
                <div class="relative h-52 overflow-hidden flex-shrink-0">
                  <img
                    src={col.coverImage}
                    alt={col.title}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.06]"
                  />
                  <!-- Gradient -->
                  <div class="absolute inset-0 bg-gradient-to-t from-senses-bg via-senses-bg/30 to-transparent" />

                  <!-- Cross-sensory badge -->
                  {col.crossSensory ? (
                    <div class="absolute top-3 left-3 flex items-center gap-1 px-2.5 py-1 rounded-full bg-black/55 backdrop-blur-sm border border-white/10">
                      <span class="text-senses-sight text-[9px] tracking-widest font-semibold">SIGHT</span>
                      <span class="text-white/30 text-[9px]">×</span>
                      <span class="text-senses-hearing text-[9px] tracking-widest font-semibold">HEARING</span>
                    </div>
                  ) : (
                    <div class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/55 backdrop-blur-sm border border-white/10">
                      <span class="text-senses-sight text-[9px] tracking-widest font-semibold">CURATED</span>
                    </div>
                  )}
                </div>

                <!-- Card body -->
                <div class="flex flex-col flex-1 p-5">
                  <h3 class="text-senses-text text-base font-medium leading-tight mb-2
                             group-hover:text-senses-accent transition-colors duration-200">
                    {col.title}
                  </h3>
                  <p class="text-senses-text-3 text-sm leading-relaxed line-clamp-2 mb-4 flex-1">
                    {col.description}
                  </p>
                  <!-- Tags + arrow -->
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex flex-wrap gap-1">
                      {col.tags.slice(0, 3).map(tag => (
                        <span class="px-2 py-0.5 rounded bg-senses-surface-2 text-senses-text-3 text-[10px] border border-senses-border capitalize">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
                      class="w-4 h-4 text-senses-text-3 group-hover:text-senses-accent flex-shrink-0 transition-colors -translate-x-1 group-hover:translate-x-0 duration-200">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m6 3 5 5-5 5"/>
                    </svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Browse by Topic: tag-based mosaic cards -->
      {tagGroups.length > 0 && (
        <section class="mb-12">
          <div class="mb-6">
            <h2 class="text-senses-text text-xl font-light mb-1">Browse by Topic</h2>
            <p class="text-senses-text-3 text-sm">Explore the media library by subject — each card shows real photos from that category.</p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
            {tagGroups.map(({ tag, slug, label, count, thumbnails }) => (
              <a
                href={`/tag/${slug}`}
                data-mosaic
                class="group relative rounded-2xl overflow-hidden bg-senses-surface border border-senses-border hover:border-senses-border-2 transition-all aspect-[4/3]"
              >
                {/* 2×2 mosaic */}
                <div class="absolute inset-0 grid grid-cols-2 grid-rows-2 gap-px bg-senses-border">
                  {thumbnails.map((src, idx) => (
                    <div class="overflow-hidden bg-senses-surface-2">
                      <img
                        src={src}
                        alt=""
                        loading="lazy"
                        class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-[1.06] transition-all duration-500"
                      />
                    </div>
                  ))}
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none" />
                <div class="absolute bottom-0 left-0 right-0 p-3">
                  <p class="text-white text-sm font-semibold leading-tight group-hover:text-senses-sight transition-colors">
                    {label}
                  </p>
                  <p class="text-white/50 text-[10px] tabular-nums mt-0.5">{count} photos</p>
                </div>
                <div class="absolute top-2.5 right-2.5 w-6 h-6 rounded-full bg-black/40 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg viewBox="0 0 16 16" fill="none" stroke="white" stroke-width="1.5" class="w-3 h-3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m3 13 10-10M5 3h8v8"/>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var cards = document.querySelectorAll('[data-mosaic]');
    cards.forEach(function (card) {
      var imgs = Array.from(card.querySelectorAll('img'));
      var srcs = imgs.map(function (img) { return img.src; });
      for (var i = srcs.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = srcs[i]; srcs[i] = srcs[j]; srcs[j] = tmp;
      }
      imgs.forEach(function (img, idx) { img.src = srcs[idx]; });
    });
  });
</script>
