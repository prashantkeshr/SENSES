---
import BaseLayout    from '@/layouts/BaseLayout.astro';
import { provider }  from '@/lib/providers';
import { formatDate } from '@/lib/utils/formatters';

const collections = await provider.getCollections();
const featured    = collections.filter(c => c.featured);
const rest        = collections.filter(c => !c.featured);
---

<BaseLayout
  title="Collections — SENSES"
  description="Curated cross-sensory collections pairing visual and audio media into unified moods. Explore themed sets crafted by SENSES."
>
  <div class="pt-[var(--nav-height)] pb-20">

    <!-- Header -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 py-10 pb-8 border-b border-senses-border mb-10">
      <p class="text-senses-text-3 text-xs tracking-widest uppercase mb-2">Curated Sets</p>
      <h1 class="text-display-xl text-senses-text leading-none">Collections</h1>
      <p class="text-senses-text-3 text-sm mt-3 max-w-lg">
        Themed groupings of visual and audio media curated for mood, moment, and sensory experience.
        Many collections span both SIGHT and HEARING for a complete atmosphere.
      </p>
    </div>

    <div class="max-w-[1440px] mx-auto px-4 md:px-8">

      <!-- Featured collections: large cards -->
      {featured.length > 0 && (
        <section class="mb-12">
          <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-5 font-medium">Featured</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {featured.map(col => (
              <a
                href={`/collections/${col.slug}`}
                class="group relative rounded-2xl overflow-hidden bg-senses-surface border border-senses-border hover:border-senses-border-2 transition-all"
              >
                <!-- Cover image -->
                <div class="relative h-48 overflow-hidden">
                  <img
                    src={col.coverImage}
                    alt={col.title}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-senses-bg via-senses-bg/40 to-transparent" />

                  <!-- Cross-sensory badge -->
                  {col.crossSensory && (
                    <div class="absolute top-3 right-3 flex items-center gap-1 px-2.5 py-1 rounded-full bg-black/50 backdrop-blur-sm border border-white/10">
                      <span class="text-senses-sight text-[9px] tracking-widest font-medium">SIGHT</span>
                      <span class="text-white/30 text-[9px]">×</span>
                      <span class="text-senses-hearing text-[9px] tracking-widest font-medium">HEARING</span>
                    </div>
                  )}
                </div>

                <div class="p-5">
                  <h3 class="text-senses-text text-lg font-medium leading-tight mb-2 group-hover:text-senses-accent transition-colors">
                    {col.title}
                  </h3>
                  <p class="text-senses-text-3 text-sm leading-relaxed line-clamp-2 mb-4">
                    {col.description}
                  </p>
                  <div class="flex items-center justify-between">
                    <div class="flex gap-1.5 flex-wrap">
                      {col.tags.slice(0, 4).map(tag => (
                        <span class="px-2 py-0.5 rounded bg-senses-surface-2 text-senses-text-3 text-[10px]">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <span class="text-senses-text-3 text-xs flex-shrink-0 ml-2">
                      {col.mediaIds.length} items
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- More collections: smaller grid -->
      {rest.length > 0 && (
        <section class="mb-12">
          <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-5 font-medium">More Collections</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            {rest.map(col => (
              <a
                href={`/collections/${col.slug}`}
                class="group rounded-xl overflow-hidden bg-senses-surface border border-senses-border hover:border-senses-border-2 transition-all"
              >
                <div class="relative h-36 overflow-hidden">
                  <img
                    src={col.coverImage}
                    alt={col.title}
                    class="w-full h-full object-cover opacity-70 transition-transform duration-700 group-hover:scale-[1.04]"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-senses-bg/80 to-transparent" />
                  {col.crossSensory && (
                    <div class="absolute top-2.5 right-2.5 flex items-center gap-1 px-2 py-0.5 rounded-full bg-black/50 backdrop-blur-sm border border-white/10">
                      <span class="text-senses-sight text-[8px] tracking-wider">S</span>
                      <span class="text-white/30 text-[8px]">×</span>
                      <span class="text-senses-hearing text-[8px] tracking-wider">H</span>
                    </div>
                  )}
                </div>
                <div class="p-4">
                  <h3 class="text-senses-text text-sm font-medium mb-1 group-hover:text-senses-accent transition-colors">
                    {col.title}
                  </h3>
                  <p class="text-senses-text-3 text-xs leading-relaxed line-clamp-2 mb-2">
                    {col.description}
                  </p>
                  <span class="text-senses-text-3 text-[10px]">{col.mediaIds.length} items</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </div>
</BaseLayout>
