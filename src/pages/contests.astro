---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contests — Senses"
  description="Join creative photography and media contests. Compete, get featured, and win recognition from the Senses community."
>
  <div class="max-w-4xl mx-auto px-4 py-24 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-senses-accent/10 border border-senses-accent/25 text-senses-accent text-xs tracking-widest uppercase mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-senses-accent animate-pulse inline-block"></span>
      Coming Soon
    </div>
    <h1 class="text-5xl font-light text-senses-text mb-6 leading-tight">
      Senses <span class="brand-shimmer">Contests</span>
    </h1>
    <p class="text-senses-text-2 text-lg leading-relaxed max-w-2xl mx-auto mb-16">
      Weekly and monthly creative challenges where photographers, videographers, and artists compete for community recognition,
      editorial features, and exclusive badges on their Senses profile.
    </p>
    <div class="grid sm:grid-cols-3 gap-6 text-left mb-16">
      {[
        { icon: '🏆', title: 'Weekly Themes', desc: 'Fresh creative prompts every Monday. Submit your best work before Sunday.' },
        { icon: '✨', title: 'Editorial Pick', desc: 'Top entries get featured on the Senses homepage and Editorial collection.' },
        { icon: '🎖️', title: 'Creator Badges', desc: 'Win contests to earn exclusive badges that appear on your creator profile.' },
      ].map(f => (
        <div class="bg-senses-surface border border-senses-border rounded-2xl p-6">
          <div class="text-3xl mb-3">{f.icon}</div>
          <h3 class="text-senses-text font-medium mb-2">{f.title}</h3>
          <p class="text-senses-text-3 text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
    <p class="text-senses-text-3 text-sm">Notify me when Contests launch →
      <a href="/settings" class="text-senses-accent hover:underline ml-1">Update notification preferences</a>
    </p>
  </div>
</BaseLayout>
