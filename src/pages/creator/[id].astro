---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MediaCard } from '@/components/media/MediaCard';
import { provider }  from '@/lib/providers';
import { formatCount, formatDate } from '@/lib/utils/formatters';

export async function getStaticPaths() {
  const creators = await provider.getCreators(100);
  return creators.map(c => ({
    params: { id: c.id },
    props:  { creatorId: c.id },
  }));
}

interface Props { creatorId: string }
const { creatorId } = Astro.props;

const [creator, creatorMedia, allCreators] = await Promise.all([
  provider.getCreatorById(creatorId),
  provider.getCreatorMedia(creatorId),
  provider.getCreators(50),
]);

if (!creator) return Astro.redirect('/');

const creatorMap = Object.fromEntries(allCreators.map(c => [c.id, c]));

const sightItems   = creatorMedia.filter(m => m.division === 'sight');
const hearingItems = creatorMedia.filter(m => m.division === 'hearing');
const hasMedia     = creatorMedia.length > 0;
---

<BaseLayout
  title={`${creator.displayName} — Creator · SENSES`}
  description={creator.bio}
  ogImage={creator.avatar}
>
  <div class="pt-[var(--nav-height)] pb-20">

    <!-- Hero -->
    <div class="relative overflow-hidden border-b border-senses-border mb-10">
      <!-- Background blur -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div
          class="absolute inset-0 scale-110 blur-3xl opacity-10"
          style={`background: radial-gradient(ellipse 80% 60% at 50% 0%, ${creator.featured ? '#C8B89A' : '#8FAEC0'} 0%, transparent 70%)`}
        />
      </div>

      <div class="relative max-w-[1440px] mx-auto px-4 md:px-8 py-12">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">

          <!-- Avatar -->
          <div class="relative flex-shrink-0">
            <img
              src={creator.avatar}
              alt={creator.displayName}
              class="w-24 h-24 rounded-2xl object-cover border border-senses-border"
            />
            {creator.verified && (
              <div
                class="absolute -bottom-1.5 -right-1.5 w-6 h-6 rounded-full bg-senses-bg border border-senses-border flex items-center justify-center"
                title="Verified creator"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-senses-accent">
                  <path fill-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0 1 12 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 0 1 3.498 1.307 4.491 4.491 0 0 1 1.307 3.497A4.49 4.49 0 0 1 21.75 12a4.49 4.49 0 0 1-1.549 3.397 4.491 4.491 0 0 1-1.307 3.497 4.491 4.491 0 0 1-3.497 1.307A4.49 4.49 0 0 1 12 21.75a4.49 4.49 0 0 1-3.397-1.549 4.491 4.491 0 0 1-3.497-1.307 4.491 4.491 0 0 1-1.307-3.497A4.49 4.49 0 0 1 2.25 12a4.49 4.49 0 0 1 1.549-3.397 4.491 4.491 0 0 1 1.307-3.497 4.491 4.491 0 0 1 3.497-1.307Zm7.007 6.387a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" />
                </svg>
              </div>
            )}
          </div>

          <!-- Info -->
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-1">
              <h1 class="text-display-sm text-senses-text">{creator.displayName}</h1>
              {creator.featured && (
                <span class="px-2 py-0.5 rounded-full text-[10px] bg-senses-accent/10 text-senses-accent border border-senses-accent/20 tracking-widest uppercase font-medium">
                  Featured
                </span>
              )}
            </div>
            <p class="text-senses-text-3 text-sm mb-2">@{creator.username}</p>
            {creator.location && (
              <p class="text-senses-text-3 text-sm mb-3 flex items-center gap-1.5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-3.5 h-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
                {creator.location}
              </p>
            )}
            <p class="text-senses-text-2 text-sm max-w-xl leading-relaxed">{creator.bio}</p>
          </div>

          <!-- Stats -->
          <div class="flex gap-6 flex-shrink-0 sm:text-right">
            {[
              [formatCount(creator.stats.mediaCount), 'items'],
              [formatCount(creator.stats.totalViews), 'views'],
              [formatCount(creator.stats.followers), 'followers'],
            ].map(([n, l]) => (
              <div>
                <p class="text-senses-text text-xl font-light">{n}</p>
                <p class="text-senses-text-3 text-[10px] uppercase tracking-widest">{l}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Specialties + links row -->
        <div class="flex flex-wrap items-center gap-3 mt-6 pt-6 border-t border-senses-border">
          <div class="flex flex-wrap gap-1.5 flex-1">
            {creator.specialties.map(s => (
              <a
                href={`/search?q=${encodeURIComponent(s)}`}
                class="px-2.5 py-1 rounded-lg text-xs bg-senses-surface border border-senses-border text-senses-text-3 hover:text-senses-text hover:border-senses-border-2 transition-all"
              >
                {s}
              </a>
            ))}
          </div>
          <div class="flex items-center gap-3">
            <p class="text-senses-text-3 text-xs">Joined {formatDate(creator.joinedAt)}</p>
            {creator.website && creator.website !== 'https://placeholder.senses.com' && (
              <a
                href={creator.website}
                target="_blank"
                rel="noopener noreferrer"
                class="text-senses-text-3 hover:text-senses-text text-xs transition-colors"
              >
                Website →
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Media -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8">
      {!hasMedia && (
        <div class="py-24 text-center">
          <p class="text-senses-text-3 text-lg">No media yet</p>
          <p class="text-senses-text-3 text-sm mt-1">This creator hasn't published any media yet.</p>
        </div>
      )}

      {sightItems.length > 0 && (
        <section class="mb-12">
          {hearingItems.length > 0 && (
            <div class="flex items-center gap-2 mb-5">
              <div class="w-2 h-2 rounded-full bg-senses-sight" />
              <h2 class="text-senses-sight text-xs tracking-widest uppercase font-medium">
                Visual · {sightItems.length} items
              </h2>
            </div>
          )}
          {hearingItems.length === 0 && (
            <h2 class="text-senses-text text-base font-medium mb-5">
              All Media <span class="text-senses-text-3 text-sm font-normal">· {sightItems.length} items</span>
            </h2>
          )}
          <div class="masonry-grid">
            {sightItems.map(item => (
              <MediaCard client:visible media={item} creator={creator} />
            ))}
          </div>
        </section>
      )}

      {hearingItems.length > 0 && (
        <section class="mb-12">
          {sightItems.length > 0 && (
            <div class="flex items-center gap-2 mb-5">
              <div class="w-2 h-2 rounded-full bg-senses-hearing" />
              <h2 class="text-senses-hearing text-xs tracking-widest uppercase font-medium">
                Audio · {hearingItems.length} items
              </h2>
            </div>
          )}
          {sightItems.length === 0 && (
            <h2 class="text-senses-text text-base font-medium mb-5">
              All Media <span class="text-senses-text-3 text-sm font-normal">· {hearingItems.length} items</span>
            </h2>
          )}
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
            {hearingItems.map(item => (
              <MediaCard client:visible media={item} creator={creator} layout="grid" />
            ))}
          </div>
        </section>
      )}
    </div>

  </div>
</BaseLayout>
