---
import BaseLayout      from '@/layouts/BaseLayout.astro';
import { DiscoverFeed } from '@/components/discover/DiscoverFeed';
import { provider }     from '@/lib/providers';

const [allMedia, allCreators] = await Promise.all([
  provider.getMedia(),
  provider.getCreators(50),
]);

// Interleave sight + hearing for variety, featured/trending first within each
const sight   = allMedia.filter(m => m.division === 'sight')
  .sort((a, b) => (b.trending ? 1 : 0) - (a.trending ? 1 : 0) || (b.featured ? 1 : 0) - (a.featured ? 1 : 0));
const hearing = allMedia.filter(m => m.division === 'hearing')
  .sort((a, b) => (b.trending ? 1 : 0) - (a.trending ? 1 : 0) || (b.featured ? 1 : 0) - (a.featured ? 1 : 0));

// Interleave: ~2 sight, 1 hearing, repeat
const feed: typeof allMedia = [];
let si = 0, hi = 0;
while (si < sight.length || hi < hearing.length) {
  if (si < sight.length) feed.push(sight[si++]);
  if (si < sight.length) feed.push(sight[si++]);
  if (hi < hearing.length) feed.push(hearing[hi++]);
}
---

<BaseLayout
  title="Discover — SENSES"
  description="Scroll through premium visual and audio media. A full-screen discovery experience for SIGHT and HEARING."
  bodyClass="overflow-hidden"
  noFooter={true}
>
  <DiscoverFeed
    client:load
    media={feed}
    creators={allCreators}
  />
</BaseLayout>
