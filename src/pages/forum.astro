---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Forum — Senses"
  description="Join the Senses community forum. Discuss photography, music, technique, gear, and more with creators worldwide."
  noIndex={true}
>
  <div class="max-w-4xl mx-auto px-4 py-24 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-senses-hearing/10 border border-senses-hearing/25 text-senses-hearing text-xs tracking-widest uppercase mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-senses-hearing animate-pulse inline-block"></span>
      Coming Soon
    </div>
    <h1 class="text-5xl font-light text-senses-text mb-6 leading-tight">
      Senses <span class="brand-shimmer">Forum</span>
    </h1>
    <p class="text-senses-text-2 text-lg leading-relaxed max-w-2xl mx-auto mb-16">
      A dedicated space for the Senses community to connect, share knowledge, critique work, and discover new perspectives.
      From beginner questions to pro technique discussions — everyone belongs here.
    </p>
    <div class="grid sm:grid-cols-3 gap-6 text-left mb-16">
      {[
        { icon: '💬', title: 'Creative Discussions', desc: 'Talk photography, videography, sound design, composition, and more.' },
        { icon: '🔍', title: 'Critique & Feedback', desc: 'Post your work and get constructive feedback from the community.' },
        { icon: '📚', title: 'Resource Hub', desc: 'Find tutorials, gear recommendations, and workflow tips shared by creators.' },
      ].map(f => (
        <div class="bg-senses-surface border border-senses-border rounded-2xl p-6">
          <div class="text-3xl mb-3">{f.icon}</div>
          <h3 class="text-senses-text font-medium mb-2">{f.title}</h3>
          <p class="text-senses-text-3 text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
    <a href="/" class="text-senses-text-3 text-sm hover:text-senses-text transition-colors">← Back to Senses</a>
  </div>
</BaseLayout>
