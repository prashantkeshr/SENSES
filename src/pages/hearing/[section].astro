---
import BaseLayout      from '@/layouts/BaseLayout.astro';
import { LoadMoreGrid } from '@/components/media/LoadMoreGrid';
import { formatCount }  from '@/lib/utils/formatters';
import musicStats from '@data/pb/music-stats.json';
import type { Media } from '@/types/index';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

const SECTION_GENRES: Record<string, string[]> = {
  music:   ['rock','electronic','jazz','classical','pop','cinematic','folk','hip-hop','world','ambient','other'],
  ambient: ['ambient'],
  sounds:  ['world','folk','other'],
  'lo-fi': ['hip-hop','electronic','pop'],
};

const SECTION_META: Record<string, { title: string; description: string }> = {
  music:   { title: 'Music',   description: 'Royalty-free music across every genre — cinematic scores, orchestral compositions, electronic beats and more.' },
  sounds:  { title: 'Sounds',  description: 'World, folk and organic soundscapes — nature-inspired music free for any use, no attribution required.' },
  ambient: { title: 'Ambient', description: 'Atmospheric ambient tracks for focus, sleep, relaxation and deep work environments.' },
  'lo-fi': { title: 'Lo-Fi',   description: 'Mellow hip-hop, chill electronic and laid-back beats for studying, creating, and slow afternoons.' },
};

export async function getStaticPaths() {
  const sections = ['music', 'sounds', 'ambient', 'lo-fi'];
  return sections.map(section => ({
    params: { section },
    props:  { section },
  }));
}

interface Props { section: string }
const { section } = Astro.props;

const meta = SECTION_META[section];
if (!meta) return Astro.redirect('/hearing');

const genres = SECTION_GENRES[section] ?? [];

// Read music chunks at build time — produce initial 48 items for SSG
const root = process.cwd();
let initialItems: Media[] = [];
try {
  const chunksDir = join(root, 'public', 'data', 'pb', 'music', 'chunks');
  const allItems: any[] = [];
  for (const file of readdirSync(chunksDir)) {
    if (!file.endsWith('.json')) continue;
    const chunk: any[] = JSON.parse(readFileSync(join(chunksDir, file), 'utf-8'));
    allItems.push(...chunk);
  }
  const filtered = section === 'music'
    ? allItems
    : allItems.filter((m: any) => genres.includes(m.category));
  filtered.sort((a: any, b: any) => (b.stats?.likes ?? 0) - (a.stats?.likes ?? 0));
  // Serve first chunk file worth so Load More starts from chunk 1
  initialItems = filtered.slice(0, 100) as Media[];
} catch { /* chunks not yet generated */ }

const sectionCount = section === 'music'
  ? musicStats.total
  : genres.reduce((t, g) => t + ((musicStats.byGenre as any)[g] ?? 0), 0);
---

<BaseLayout
  title={`${meta.title} — HEARING · Senses`}
  description={meta.description}
>
  <div class="pt-[var(--nav-height)] pb-20">

    <!-- Breadcrumb -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 py-5">
      <nav class="flex items-center gap-1.5 text-xs text-senses-text-3">
        <a href="/" class="hover:text-senses-text transition-colors">Senses</a>
        <span>/</span>
        <a href="/hearing" class="text-senses-hearing hover:text-senses-text transition-colors">HEARING</a>
        <span>/</span>
        <span class="text-senses-text">{meta.title}</span>
      </nav>
    </div>

    <!-- Header -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 pb-8 border-b border-senses-border mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <p class="text-senses-hearing text-xs tracking-widest uppercase mb-2 font-medium">HEARING · {meta.title}</p>
          <h1 class="text-display-lg text-senses-text">{meta.title}</h1>
          <p class="text-senses-text-3 text-sm mt-2 max-w-lg">{meta.description}</p>
        </div>
        <div class="text-right flex-shrink-0">
          <p class="text-senses-hearing text-3xl font-light tabular-nums">{sectionCount.toLocaleString()}</p>
          <p class="text-senses-text-3 text-xs uppercase tracking-widest">tracks</p>
        </div>
      </div>
    </div>

    <!-- Grid with Load More -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8">
      {initialItems.length === 0 ? (
        <div class="py-24 text-center">
          <p class="text-senses-text-3 text-lg mb-2">No tracks found</p>
          <p class="text-senses-text-3 text-sm">Run <code class="bg-senses-surface px-1.5 py-0.5 rounded text-xs">npm run transform:music</code> to generate music data.</p>
        </div>
      ) : (
        <LoadMoreGrid
          client:load
          initialItems={initialItems}
          chunkBasePath="/data/pb/music/chunks/"
          startChunk={1}
          totalCount={sectionCount}
          division="hearing"
          layout="grid"
        />
      )}
    </div>

  </div>
</BaseLayout>
