---
import BaseLayout       from '@/layouts/BaseLayout.astro';
import { AudioPlayer }  from '@/components/media/AudioPlayer';
import { MediaActions } from '@/components/media/MediaActions';
import { MediaCard }    from '@/components/media/MediaCard';
import { TypeBadge }    from '@/components/ui/Badge';
import { CommentsSection } from '@/components/social/CommentsSection';
import { provider }     from '@/lib/providers';
import { formatCount, formatDate, formatDuration } from '@/lib/utils/formatters';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';
import type { AudioData, Creator, Media } from '@/types/index';

// ── Build-time: map Pixabay music item → Media + AudioData ───────────────────
function pbMusToMedia(item: any): Media {
  const tags   = Array.isArray(item.tags) ? item.tags : [];
  const title  = item.title || `Free Music Track`;
  const artist = item.creatorName || 'Unknown Artist';
  const dur    = item.data?.duration ?? item.data?.duration ?? 0;
  const desc   = item.description || `Free royalty-free music track "${title}" by ${artist}. No attribution required.`;

  return {
    id:           item.id,
    type:         'track' as any,
    division:     'hearing',
    slug:         item.slug,
    title,
    description:  desc,
    creator:      item.creator ?? `pmus-user-${artist}`,
    creatorName:  artist,
    creatorAvatar: item.creatorAvatar || '',
    thumbnail:    item.thumbnail || item.data?.coverUrl || '',
    category:     item.category || 'music',
    tags,
    moods:        item.moods || [],
    styles:       item.styles || [],
    colors:       item.colors || [],
    orientation:  'square',
    license:      'pixabay' as any,
    attribution:  artist,
    source:       'pixabay',
    featured:     item.featured ?? false,
    trending:     item.trending ?? false,
    editorsPick:  item.editorsPick ?? false,
    stats: {
      views:     item.stats?.views     ?? 0,
      downloads: item.stats?.downloads ?? 0,
      likes:     item.stats?.likes     ?? 0,
      saves:     0,
    },
    createdAt:    item.createdAt || '',
    updatedAt:    '',
    seo: {
      title:       item.seo?.title       ?? `${title} — Free Music`,
      description: item.seo?.description ?? desc,
      keywords:    item.seo?.keywords    ?? [...tags.slice(0,8), 'free music', 'royalty free'],
    },
    data: {
      streamUrl:   item.data?.streamUrl ?? item.data?.audioUrl ?? '',
      artworkUrl:  item.thumbnail || item.data?.artworkUrl || item.data?.coverUrl || '',
      duration:    dur,
      format:      item.data?.format || 'MP3',
      bitrate:     0,
      sampleRate:  44100,
      channels:    2,
      waveformData: item.data?.waveformData?.length ? item.data.waveformData : undefined,
    },
  } as unknown as Media;
}

export async function getStaticPaths() {
  // Curated hearing items
  const curatedMedia = await provider.getMedia({ division: 'hearing' });
  const curatedPaths = curatedMedia.map((m: any) => ({
    params: { type: m.type, slug: m.slug },
    props:  { mediaId: m.id, pbItem: null as any },
  }));

  // Pixabay music — read all committed chunk files at build time
  const pbMap = new Map<string, any>();
  const root  = process.cwd();
  try {
    const chunksDir = join(root, 'public', 'data', 'pb', 'music', 'chunks');
    for (const file of readdirSync(chunksDir)) {
      if (!file.endsWith('.json')) continue;
      const items: any[] = JSON.parse(readFileSync(join(chunksDir, file), 'utf-8'));
      for (const item of items) {
        if (item.slug && !pbMap.has(item.slug)) pbMap.set(item.slug, item);
      }
    }
  } catch { /* chunks absent in fresh clone before transform */ }

  const pbPaths = [...pbMap.values()].map((item: any) => ({
    params: { type: 'track', slug: item.slug as string },
    props:  { mediaId: item.id as string, pbItem: item },
  }));

  return [...curatedPaths, ...pbPaths];
}

interface Props { mediaId: string; pbItem: any | null }
const { mediaId, pbItem } = Astro.props;

const isPb = pbItem !== null;
let media: Media | null = null;
let creator: Creator | undefined;
let related: Media[] = [];
let crossSensory: { sight: Media[]; hearing: Media[] } = { sight: [], hearing: [] };
let moreByCreator: Media[] = [];

if (isPb) {
  media = pbMusToMedia(pbItem);
} else {
  const [fetchedMedia, fetchedRelated, fetchedCross, creators] = await Promise.all([
    provider.getMediaById(mediaId),
    provider.getRelatedMedia(mediaId, 6),
    provider.getCrossSensory(mediaId),
    provider.getCreators(30),
  ]);
  if (!fetchedMedia) return Astro.redirect('/404');
  media = fetchedMedia;
  const creatorMap = Object.fromEntries(creators.map(c => [c.id, c]));
  creator = creatorMap[media.creator] as Creator | undefined;
  related = fetchedRelated;
  crossSensory = fetchedCross;
  const creatorMore = await provider.getCreatorMedia(media.creator, { limit: 5 });
  moreByCreator = creatorMore.filter(m => m.id !== media!.id).slice(0, 4);
}

if (!media) return Astro.redirect('/404');

const audioData = media.data as AudioData;
const ogImage   = audioData.artworkUrl ?? media.thumbnail;
const durationSec = audioData.duration ?? 0;

const licenseLabels: Record<string, string> = {
  cc0:               'CC0 Public Domain',
  'cc-by':           'Creative Commons BY',
  'cc-by-sa':        'Creative Commons BY-SA',
  editorial:         'Editorial Use Only',
  commercial:        'Commercial License',
  'senses-original': 'Senses Original',
  placeholder:       'Placeholder (V1)',
  pixabay:           'Pixabay License',
};
---

<BaseLayout
  title={media.seo.title}
  description={media.seo.description}
  ogImage={ogImage}
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "MusicRecording",
        "name": media.title,
        "description": media.description,
        "thumbnailUrl": ogImage,
        "byArtist": isPb && (media as any).creatorName
          ? { "@type": "MusicGroup", "name": (media as any).creatorName }
          : creator ? { "@type": "Person", "name": creator.displayName } : undefined,
        "duration": durationSec ? `PT${Math.floor(durationSec)}S` : undefined,
        "inLanguage": "en",
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Senses",  "item": "https://senses.dhurta.org" },
          { "@type": "ListItem", "position": 2, "name": "HEARING", "item": "https://senses.dhurta.org/hearing" },
          { "@type": "ListItem", "position": 3, "name": "Music",   "item": "https://senses.dhurta.org/hearing/track" },
          { "@type": "ListItem", "position": 4, "name": media.title },
        ],
      },
    ],
  }}
>
  <div class="pt-[var(--nav-height)] pb-20">

    <!-- Hero: artwork + player -->
    <div class="bg-senses-surface-2 border-b border-senses-border mb-10">
      <div class="max-w-[1200px] mx-auto px-4 md:px-8">

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-1.5 text-xs text-senses-text-3 py-5 flex-wrap" aria-label="Breadcrumb">
          <a href="/" class="hover:text-senses-text transition-colors">Senses</a>
          <span>/</span>
          <a href="/hearing" class="text-senses-hearing hover:text-senses-text transition-colors">HEARING</a>
          <span>/</span>
          <span class="capitalize">{media.type}</span>
          <span>/</span>
          <span class="text-senses-text truncate max-w-[200px]">{media.title}</span>
        </nav>

        <!-- Artwork + player row -->
        <div class="flex flex-col md:flex-row gap-8 pb-10">
          <!-- Album art -->
          <div class="flex-shrink-0 mx-auto md:mx-0">
            <div class="w-56 h-56 md:w-64 md:h-64 rounded-2xl overflow-hidden bg-senses-surface shadow-xl shadow-black/40 relative">
              {ogImage ? (
                <img src={ogImage} alt={media.title} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-senses-hearing/20 to-senses-hearing/5">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16 text-senses-hearing/40">
                    <path d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                  </svg>
                </div>
              )}
              <!-- Genre badge -->
              {media.category && (
                <div class="absolute bottom-2 left-2">
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-black/60 text-white/80 capitalize tracking-wide">
                    {media.category}
                  </span>
                </div>
              )}
            </div>
          </div>

          <!-- Player + info -->
          <div class="flex-1 min-w-0 flex flex-col justify-center">
            <div class="flex items-center gap-2 mb-3 flex-wrap">
              <TypeBadge type={media.type} division="hearing" />
              <span class="text-senses-hearing text-xs tracking-widest font-medium uppercase">Hearing</span>
              {media.editorsPick && (
                <span class="text-[10px] px-2 py-0.5 rounded border border-senses-hearing/30 text-senses-hearing/80 tracking-widest uppercase">
                  Editor's Pick
                </span>
              )}
            </div>

            <h1 class="text-display-lg text-senses-text leading-tight mb-1">{media.title}</h1>

            {isPb && (media as any).creatorName ? (
              <p class="text-senses-text-3 text-sm mb-1">
                by <span class="text-senses-text-2">{(media as any).creatorName}</span>
              </p>
            ) : creator ? (
              <p class="text-senses-text-3 text-sm mb-1">
                by <a href={`/creator/${creator.id}`} class="text-senses-text-2 hover:text-senses-text transition-colors">{creator.displayName}</a>
              </p>
            ) : null}

            <!-- Duration + Format chips -->
            <div class="flex items-center gap-2 mb-6 flex-wrap">
              {durationSec > 0 && (
                <span class="text-xs px-2 py-0.5 rounded-full bg-senses-surface border border-senses-border text-senses-text-3">
                  {formatDuration(durationSec)}
                </span>
              )}
              {audioData.format && (
                <span class="text-xs px-2 py-0.5 rounded-full bg-senses-surface border border-senses-border text-senses-text-3 uppercase">
                  {audioData.format}
                </span>
              )}
            </div>

            <!-- Audio player -->
            <AudioPlayer client:load data={audioData} title={media.title} accentColor="#8FAEC0" />
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-[1200px] mx-auto px-4 md:px-8">

      <!-- Actions -->
      <div class="mb-10">
        <MediaActions client:load media={media} />
      </div>

      <!-- Main 2-col layout -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-14">

        <!-- Left: description + tags + technical -->
        <div class="lg:col-span-2 space-y-8">

          <!-- Description -->
          <section>
            <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">About</h2>
            <p class="text-senses-text-2 leading-relaxed text-base">{media.description}</p>
          </section>

          <!-- Tags -->
          {media.tags.length > 0 && (
            <section>
              <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">Tags</h2>
              <div class="flex flex-wrap gap-1.5">
                {media.tags.slice(0, 20).map(tag => (
                  <a
                    href={`/search?q=${encodeURIComponent(tag)}`}
                    class="px-2.5 py-1 rounded-lg text-xs bg-senses-surface border border-senses-border text-senses-text-3 hover:border-senses-hearing/40 hover:text-senses-hearing transition-all capitalize"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- Moods + Styles (curated only) -->
          {!isPb && (media.moods.length > 0 || media.styles.length > 0) && (
            <section class="grid grid-cols-2 gap-6">
              {media.moods.length > 0 && (
                <div>
                  <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">Mood</h2>
                  <div class="flex flex-wrap gap-1.5">
                    {media.moods.map(m => (
                      <a href={`/mood/${m}`} class="px-2.5 py-1 rounded-lg text-xs bg-senses-hearing/10 border border-senses-hearing/20 text-senses-hearing/90 capitalize hover:border-senses-hearing/50 transition-all">{m}</a>
                    ))}
                  </div>
                </div>
              )}
              {media.styles.length > 0 && (
                <div>
                  <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">Style</h2>
                  <div class="flex flex-wrap gap-1.5">
                    {media.styles.map(s => (
                      <a href={`/style/${s}`} class="px-2.5 py-1 rounded-lg text-xs bg-senses-surface-2 border border-senses-border text-senses-text-3 capitalize hover:border-senses-border-2 transition-all">{s.replace(/-/g,' ')}</a>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )}

          <!-- Technical info -->
          <section>
            <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">Technical</h2>
            <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-3">
              {[
                ['Duration',   durationSec > 0 ? formatDuration(durationSec) : '—'],
                ['Format',     audioData.format || '—'],
                ['Channels',   audioData.channels === 2 ? 'Stereo' : audioData.channels === 1 ? 'Mono' : '2ch Stereo'],
                ['Genre',      media.category || '—'],
                ...(audioData.bitrate ? [['Bitrate', `${audioData.bitrate} kbps`]] : []),
                ...(audioData.bpm ? [['BPM', String(audioData.bpm)]] : []),
                ...(audioData.key ? [['Key',  audioData.key]] : []),
              ].map(([label, value]) => (
                <div>
                  <dt class="text-senses-text-3 text-[10px] uppercase tracking-wider mb-0.5">{label}</dt>
                  <dd class="text-senses-text-2 text-sm font-mono capitalize">{value}</dd>
                </div>
              ))}
            </dl>
          </section>
        </div>

        <!-- Right sidebar -->
        <div class="space-y-4">

          <!-- Pixabay artist card -->
          {isPb && (media as any).creatorName && (
            <div class="rounded-xl bg-senses-surface border border-senses-border p-4">
              <div class="flex items-center gap-3">
                {(media as any).creatorAvatar ? (
                  <img src={(media as any).creatorAvatar} alt={(media as any).creatorName} class="w-10 h-10 rounded-full object-cover bg-senses-surface-2" />
                ) : (
                  <div class="w-10 h-10 rounded-full bg-senses-hearing/15 flex items-center justify-center text-senses-hearing text-sm font-semibold">
                    {((media as any).creatorName as string)[0]?.toUpperCase()}
                  </div>
                )}
                <div>
                  <p class="text-senses-text text-sm font-medium">{(media as any).creatorName}</p>
                  <p class="text-senses-text-3 text-xs">Artist</p>
                </div>
              </div>
            </div>
          )}

          <!-- Curated creator card -->
          {!isPb && creator && (
            <div class="rounded-xl bg-senses-surface border border-senses-border p-4">
              <div class="flex items-center gap-3 mb-3">
                <img src={creator.avatar} alt={creator.displayName} class="w-10 h-10 rounded-full object-cover bg-senses-surface-2" />
                <div class="min-w-0">
                  <span class="text-senses-text text-sm font-medium truncate block">{creator.displayName}</span>
                  <span class="text-senses-text-3 text-xs">@{creator.username}</span>
                </div>
              </div>
              <a href={`/creator/${creator.id}`} class="block text-center text-xs py-2 rounded-lg bg-senses-surface-2 border border-senses-border text-senses-text-2 hover:border-senses-border-2 hover:text-senses-text transition-all">
                View Profile
              </a>
            </div>
          )}

          <!-- Stats -->
          <div class="rounded-xl bg-senses-surface border border-senses-border p-4">
            <h3 class="text-senses-text-3 text-[10px] uppercase tracking-widest mb-3">Stats</h3>
            <div class="space-y-2">
              {[
                ['Plays',     formatCount(media.stats.views)],
                ['Likes',     formatCount(media.stats.likes)],
                ['Downloads', formatCount(media.stats.downloads)],
              ].map(([lbl, val]) => (
                <div class="flex justify-between items-center">
                  <span class="text-senses-text-3 text-xs">{lbl}</span>
                  <span class="text-senses-text-2 text-sm font-medium tabular-nums">{val}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- License -->
          <div class="rounded-xl bg-senses-surface border border-senses-border p-4">
            <h3 class="text-senses-text-3 text-[10px] uppercase tracking-widest mb-2">License</h3>
            <p class="text-senses-text-2 text-sm font-medium mb-1">
              {licenseLabels[media.license] ?? media.license}
            </p>
            <p class="text-senses-text-3 text-xs leading-relaxed">
              {media.license === 'pixabay'
                ? 'Free for personal and commercial use. No attribution required.'
                : media.license === 'cc0'
                  ? 'Free for any use, no attribution required.'
                  : 'Check license details before use.'}
            </p>
          </div>

          <!-- Pixabay source icon (no link) -->
          {isPb && (
            <div class="rounded-xl bg-senses-surface border border-senses-border p-4 flex items-center gap-3">
              <svg viewBox="0 0 48 48" class="w-7 h-7 flex-shrink-0" aria-label="Pixabay">
                <circle cx="24" cy="24" r="24" fill="#1DA462"/>
                <path d="M18.5 14h4.2l2.3 6.2 2.3-6.2h4.2l-4.5 10.1 4.8 9.9h-4.2l-2.6-6.7-2.6 6.7h-4.2l4.8-9.9z" fill="#fff"/>
              </svg>
              <div>
                <p class="text-senses-text-2 text-xs font-medium">Pixabay</p>
                <p class="text-senses-text-3 text-[10px]">Music source</p>
              </div>
            </div>
          )}

          <!-- Published date -->
          {!isPb && media.createdAt && (
            <p class="text-senses-text-3 text-xs px-1">Published {formatDate(media.createdAt)}</p>
          )}
        </div>
      </div>

      <!-- Cross-sensory: Pair with Sight -->
      {!isPb && crossSensory.sight.length > 0 && (
        <section class="mb-14">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex-1 h-px bg-senses-border" />
            <h2 class="text-sm font-medium whitespace-nowrap">
              <span class="text-senses-text-3">Pair with</span>
              <span class="text-senses-sight ml-1.5 tracking-widest uppercase text-xs">Sight</span>
            </h2>
            <div class="flex-1 h-px bg-senses-border" />
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
            {crossSensory.sight.map(item => (
              <MediaCard client:visible media={item} layout="grid" />
            ))}
          </div>
        </section>
      )}

      <!-- More by creator -->
      {!isPb && moreByCreator.length > 0 && creator && (
        <section class="mb-14">
          <div class="flex items-center justify-between mb-5">
            <h2 class="text-senses-text text-sm font-medium">
              More by <span class="text-senses-hearing">{creator.displayName}</span>
            </h2>
            <a href={`/creator/${creator.id}`} class="text-senses-text-3 hover:text-senses-text text-xs transition-colors">View all →</a>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
            {moreByCreator.map(item => (
              <MediaCard client:visible media={item} creator={creator} layout="grid" />
            ))}
          </div>
        </section>
      )}

      <!-- Related -->
      {!isPb && related.length > 0 && (
        <section class="mb-14">
          <h2 class="text-senses-text text-sm font-medium mb-5">
            Related <span class="text-senses-hearing capitalize">{media.category}</span> sounds
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
            {related.map(item => (
              <MediaCard client:visible media={item} layout="grid" />
            ))}
          </div>
        </section>
      )}

      <!-- Comments -->
      <CommentsSection client:visible mediaId={media.id} division="hearing" />

    </div>
  </div>
</BaseLayout>
