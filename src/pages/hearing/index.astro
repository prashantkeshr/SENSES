---
import BaseLayout       from '@/layouts/BaseLayout.astro';
import { MediaCard }    from '@/components/media/MediaCard';
import { formatCount }  from '@/lib/utils/formatters';
import musicStats from '@data/pb/music-stats.json';
import featuredMusicRaw from '@data/pb/featured-music.json';
import type { Media } from '@/types/index';

const featuredMusic = featuredMusicRaw as unknown as Media[];

// Genre strips shown on the page
const genres = [
  { label: 'Electronic',  slug: 'electronic',  count: musicStats.byGenre.electronic },
  { label: 'Classical',   slug: 'classical',   count: musicStats.byGenre.classical },
  { label: 'Rock',        slug: 'rock',        count: musicStats.byGenre.rock },
  { label: 'Ambient',     slug: 'ambient',     count: musicStats.byGenre.ambient },
  { label: 'Pop',         slug: 'pop',         count: musicStats.byGenre.pop },
  { label: 'Jazz',        slug: 'jazz',        count: musicStats.byGenre.jazz },
  { label: 'Cinematic',   slug: 'cinematic',   count: musicStats.byGenre.cinematic },
  { label: 'Folk',        slug: 'folk',        count: musicStats.byGenre.folk },
  { label: 'Hip-Hop',     slug: 'hip-hop',     count: musicStats.byGenre['hip-hop'] },
  { label: 'World',       slug: 'world',       count: musicStats.byGenre.world },
].sort((a, b) => b.count - a.count);

// Split featured into sections
const topPicks     = featuredMusic.slice(0, 6);
const moreTracks   = featuredMusic.slice(6, 14);
---

<BaseLayout
  title="HEARING — Audio Discovery · Senses"
  description={`Discover ${formatCount(musicStats.total)}+ royalty-free music tracks — electronic, classical, cinematic, ambient, folk and more. Free to use, no attribution required.`}
>
  <div class="pt-[var(--nav-height)] pb-20">

    <!-- Hero banner -->
    <div class="relative overflow-hidden border-b border-senses-border mb-10">
      <div class="absolute inset-0 bg-gradient-to-br from-[#8FAEC0]/8 via-transparent to-transparent pointer-events-none" />
      <div class="max-w-[1440px] mx-auto px-4 md:px-8 py-14">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
          <div>
            <p class="text-senses-hearing text-xs tracking-[0.35em] uppercase mb-3 font-medium">Audio Division</p>
            <h1 class="text-display-2xl text-senses-text leading-none tracking-tight">HEARING</h1>
            <p class="text-senses-text-2 text-base mt-4 max-w-lg leading-relaxed">
              Royalty-free music, cinematic scores, ambient soundscapes — every genre curated
              for depth, mood, and moment. Free forever, no attribution required.
            </p>
            <div class="flex flex-wrap gap-3 mt-6">
              <a href="/explore?division=hearing" class="px-5 py-2.5 rounded-xl bg-senses-hearing text-senses-bg text-sm font-medium hover:bg-senses-hearing/90 transition-colors">
                Explore HEARING
              </a>
              <a href="/search?q=music" class="px-5 py-2.5 rounded-xl bg-senses-surface border border-senses-border text-senses-text-2 text-sm hover:border-senses-border-2 hover:text-senses-text transition-all">
                Search Tracks
              </a>
            </div>
          </div>
          <!-- Big numbers from real dataset -->
          <div class="flex gap-8 flex-shrink-0">
            <div class="text-center">
              <p class="text-senses-hearing text-4xl md:text-5xl font-light leading-none tabular-nums">
                {musicStats.total.toLocaleString()}
              </p>
              <p class="text-senses-text-3 text-xs uppercase tracking-widest mt-1.5">Tracks</p>
            </div>
            <div class="text-center">
              <p class="text-senses-hearing text-4xl md:text-5xl font-light leading-none tabular-nums">
                {genres.length}
              </p>
              <p class="text-senses-text-3 text-xs uppercase tracking-widest mt-1.5">Genres</p>
            </div>
            <div class="text-center">
              <p class="text-senses-hearing text-4xl md:text-5xl font-light leading-none tabular-nums">∞</p>
              <p class="text-senses-text-3 text-xs uppercase tracking-widest mt-1.5">Free</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-[1440px] mx-auto px-4 md:px-8">

      <!-- Genre strip -->
      <div class="flex gap-2 overflow-x-auto pb-2 mb-10 scrollbar-none">
        {genres.map(g => (
          <a
            href={`/search?q=${g.slug}&division=hearing`}
            class="flex-shrink-0 px-5 py-2.5 rounded-xl bg-senses-surface border border-senses-border text-sm hover:border-senses-hearing/40 hover:text-senses-hearing transition-all"
          >
            <span class="text-senses-text-2">{g.label}</span>
            <span class="text-senses-text-3 text-xs ml-1.5">{formatCount(g.count)}</span>
          </a>
        ))}
      </div>

      <!-- Featured Tracks -->
      <section class="mb-12">
        <div class="flex items-center justify-between mb-5">
          <h2 class="text-senses-text text-base font-medium">
            Top <span class="text-senses-hearing">Tracks</span>
          </h2>
          <a href="/explore?division=hearing" class="text-senses-text-3 hover:text-senses-text text-xs transition-colors">
            Browse all {musicStats.total.toLocaleString()} tracks →
          </a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {topPicks.map(item => (
            <MediaCard client:visible media={item} layout="grid" />
          ))}
        </div>
      </section>

      <!-- Genre stats cards -->
      <section class="mb-12">
        <h2 class="text-senses-text text-base font-medium mb-5">Browse by Genre</h2>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
          {genres.slice(0, 10).map((g, i) => (
            <a
              href={`/search?q=${g.slug}&division=hearing`}
              class="group relative rounded-xl bg-senses-surface border border-senses-border p-4 hover:border-senses-hearing/40 transition-all overflow-hidden"
            >
              <div class="absolute inset-0 bg-gradient-to-br from-senses-hearing/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" />
              <p class="text-senses-hearing text-2xl font-light tabular-nums mb-1">{formatCount(g.count)}</p>
              <p class="text-senses-text-2 text-sm font-medium">{g.label}</p>
              <p class="text-senses-text-3 text-[10px] uppercase tracking-widest mt-0.5">tracks</p>
            </a>
          ))}
        </div>
      </section>

      <!-- More tracks -->
      {moreTracks.length > 0 && (
        <section class="mb-12">
          <div class="flex items-center justify-between mb-5">
            <h2 class="text-senses-text text-base font-medium">
              More <span class="text-senses-hearing">Music</span>
            </h2>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {moreTracks.map(item => (
              <MediaCard client:visible media={item} layout="grid" />
            ))}
          </div>
        </section>
      )}

      <!-- Source note -->
      <div class="rounded-xl bg-senses-surface border border-senses-border p-5 flex items-start gap-4">
        <svg viewBox="0 0 48 48" class="w-8 h-8 flex-shrink-0 mt-0.5" aria-label="Pixabay">
          <circle cx="24" cy="24" r="24" fill="#1DA462"/>
          <path d="M18.5 14h4.2l2.3 6.2 2.3-6.2h4.2l-4.5 10.1 4.8 9.9h-4.2l-2.6-6.7-2.6 6.7h-4.2l4.8-9.9z" fill="#fff"/>
        </svg>
        <div>
          <p class="text-senses-text text-sm font-medium mb-1">Pixabay License</p>
          <p class="text-senses-text-3 text-xs leading-relaxed max-w-xl">
            All {musicStats.total.toLocaleString()} tracks are sourced under the Pixabay License —
            free for personal and commercial use. No attribution required.
          </p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
