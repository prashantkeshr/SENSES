---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MediaCard } from '@/components/media/MediaCard';
import { provider }  from '@/lib/providers';
import type { MediaType, MediaFilters } from '@/types/index';

type SectionDef = {
  title:       string;
  description: string;
  types:       MediaType[];
  filters?:    Partial<MediaFilters>;
};

export async function getStaticPaths() {
  const defs: Record<string, SectionDef> = {
    photos:        { title: 'Photos',        description: 'High-resolution photography across landscapes, urban scenes, minimal compositions, and more.',           types: ['photo'] },
    videos:        { title: 'Videos',        description: 'Cinematic video content — slow motion, time-lapse, and atmospheric visual storytelling.',                types: ['video'] },
    illustrations: { title: 'Illustrations', description: 'Digital art, hand-drawn styles, and creative visual interpretations.',                                  types: ['illustration', 'vector'] },
    wallpapers:    { title: 'Wallpapers',    description: 'Landscape-oriented photos perfect for desktop wallpapers and wide-format displays.',                    types: ['photo'], filters: { orientation: 'landscape' } },
  };
  return Object.entries(defs).map(([section, def]) => ({
    params: { section },
    props:  { section, def },
  }));
}

interface Props { section: string; def: SectionDef }
const { section, def } = Astro.props;

if (!def) return Astro.redirect('/sight');

const allCreators = await provider.getCreators(30);
const creatorMap  = Object.fromEntries(allCreators.map(c => [c.id, c]));

// Fetch for each type in this section
const byType = await Promise.all(
  def.types.map(type =>
    provider.getMedia({ division: 'sight', type, ...def.filters })
  )
);
const items = byType.flat();
---

<BaseLayout
  title={`${def.title} — SIGHT · SENSES`}
  description={def.description}
>
  <div class="pt-[var(--nav-height)] pb-20">

    <!-- Breadcrumb -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 py-5">
      <nav class="flex items-center gap-1.5 text-xs text-senses-text-3">
        <a href="/" class="hover:text-senses-text transition-colors">SENSES</a>
        <span>/</span>
        <a href="/sight" class="text-senses-sight hover:text-senses-text transition-colors">SIGHT</a>
        <span>/</span>
        <span class="text-senses-text">{def.title}</span>
      </nav>
    </div>

    <!-- Header -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 pb-8 border-b border-senses-border mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <p class="text-senses-sight text-xs tracking-widest uppercase mb-2 font-medium">SIGHT · {def.title}</p>
          <h1 class="text-display-lg text-senses-text">{def.title}</h1>
          <p class="text-senses-text-3 text-sm mt-2 max-w-lg">{def.description}</p>
        </div>
        <p class="text-senses-text-3 text-sm flex-shrink-0">{items.length} items</p>
      </div>
    </div>

    <!-- Grid -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8">
      {items.length === 0 ? (
        <div class="py-24 text-center">
          <p class="text-senses-text-3 text-lg mb-1">No {def.title.toLowerCase()} yet</p>
          <p class="text-senses-text-3 text-sm">Check back soon — more media is on the way.</p>
        </div>
      ) : (
        <div class="masonry-grid">
          {items.map(item => (
            <MediaCard client:visible media={item} creator={creatorMap[item.creator]} />
          ))}
        </div>
      )}
    </div>

  </div>
</BaseLayout>
