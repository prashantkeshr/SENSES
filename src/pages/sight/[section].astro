---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MediaCard }    from '@/components/media/MediaCard';
import { LoadMoreGrid } from '@/components/media/LoadMoreGrid';
import { provider }  from '@/lib/providers';
import pbStats     from '@data/pb/stats.json';
import videoStats  from '@data/pb/video-stats.json';
import type { MediaType, MediaFilters, Media } from '@/types/index';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

type SectionDef = {
  title:         string;
  description:   string;
  types:         MediaType[];
  filters?:      Partial<MediaFilters>;
  pbCount?:      number;
  chunkPath?:    string; // public path for Load More chunks
  useLoadMore?:  boolean;
};

export async function getStaticPaths() {
  const s = pbStats as { byType: Record<string,number>; total: number };
  let modelsCount = 0;
  try {
    const { readFileSync: rfs } = await import('fs');
    const { join: pjoin } = await import('path');
    const raw = rfs(pjoin(process.cwd(), 'public', 'data', 'pb', '3d', 'all.json'), 'utf-8');
    modelsCount = (JSON.parse(raw) as unknown[]).length;
  } catch { /* file missing */ }

  const defs: Record<string, SectionDef> = {
    photos:        { title: 'Photos',        description: 'High-resolution photography across landscapes, urban scenes, minimal compositions, and more.',           types: ['photo'],                  pbCount: s.byType.photo,                               chunkPath: '/data/pb/chunks/',         useLoadMore: true  },
    videos:        { title: 'Videos',        description: 'Cinematic video content — slow motion, time-lapse, and atmospheric visual storytelling.',                types: ['video'],                  pbCount: (videoStats as any).total,                    chunkPath: '/data/pb/videos/chunks/',  useLoadMore: true  },
    illustrations: { title: 'Illustrations', description: 'Digital art, hand-drawn styles, and creative visual interpretations.',                                  types: ['illustration', 'vector'], pbCount: s.byType.illustration + s.byType.vector,      chunkPath: '/data/pb/chunks/',         useLoadMore: true  },
    wallpapers:    { title: 'Wallpapers',    description: 'Landscape-oriented photos perfect for desktop wallpapers and wide-format displays.',                    types: ['photo'],                  pbCount: s.byType.photo,                               chunkPath: '/data/pb/chunks/',         useLoadMore: true  },
    '3d-models':   { title: '3D Models',     description: 'Interactive 3D objects — explore, orbit, zoom. Free GLB models for personal and commercial projects.', types: ['3d' as MediaType],        pbCount: modelsCount || undefined,                                                    useLoadMore: false },
  };
  return Object.entries(defs).map(([section, def]) => ({
    params: { section },
    props:  { section, def },
  }));
}

interface Props { section: string; def: SectionDef }
const { section, def } = Astro.props;

if (!def) return Astro.redirect('/sight');

const root = process.cwd();
let initialItems: Media[] = [];
let startChunk = 1;

if (section === 'videos') {
  try {
    const chunksDir = join(root, 'public', 'data', 'pb', 'videos', 'chunks');
    const chunk0: any[] = JSON.parse(readFileSync(join(chunksDir, '0.json'), 'utf-8'));
    chunk0.sort((a: any, b: any) => (b.stats?.views ?? 0) - (a.stats?.views ?? 0));
    initialItems = chunk0 as Media[];
    startChunk = 1;
  } catch { /* chunks absent */ }
} else if (section === '3d-models') {
  try {
    const allRaw: any[] = JSON.parse(readFileSync(join(root, 'public', 'data', 'pb', '3d', 'all.json'), 'utf-8'));
    allRaw.sort((a: any, b: any) => (b.stats?.likes ?? 0) - (a.stats?.likes ?? 0));
    initialItems = allRaw as Media[]; // show all since it's a single file
  } catch { /* file absent */ }
} else if (section === 'photos' || section === 'illustrations' || section === 'wallpapers') {
  try {
    const chunksDir = join(root, 'public', 'data', 'pb', 'chunks');
    const chunk0: any[] = JSON.parse(readFileSync(join(chunksDir, '0.json'), 'utf-8'));
    // Filter by type if needed
    const filtered = section === 'illustrations'
      ? chunk0.filter((m: any) => m.type === 'illustration' || m.type === 'vector')
      : section === 'wallpapers'
      ? chunk0.filter((m: any) => m.orientation === 'landscape')
      : chunk0;
    initialItems = filtered as Media[];
    startChunk = 1;
  } catch { /* chunks absent */ }
  if (initialItems.length === 0) {
    // Fallback to provider for curated items
    const allCreators = await provider.getCreators(30);
    const byType = await Promise.all(
      def.types.map(type => provider.getMedia({ division: 'sight', type, ...def.filters }))
    );
    initialItems = byType.flat();
  }
} else {
  const byType = await Promise.all(
    def.types.map(type => provider.getMedia({ division: 'sight', type, ...def.filters }))
  );
  initialItems = byType.flat();
}

const isGridSection = section === 'videos' || section === '3d-models';
const gridLayout: 'grid' | 'masonry' = isGridSection ? 'grid' : 'masonry';
---

<BaseLayout
  title={`${def.title} — SIGHT · Senses`}
  description={def.description}
>
  <div class="pt-[var(--nav-height)] pb-20">

    <!-- Breadcrumb -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 py-5">
      <nav class="flex items-center gap-1.5 text-xs text-senses-text-3">
        <a href="/" class="hover:text-senses-text transition-colors">Senses</a>
        <span>/</span>
        <a href="/sight" class="text-senses-sight hover:text-senses-text transition-colors">SIGHT</a>
        <span>/</span>
        <span class="text-senses-text">{def.title}</span>
      </nav>
    </div>

    <!-- Header -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 pb-8 border-b border-senses-border mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <p class="text-senses-sight text-xs tracking-widest uppercase mb-2 font-medium">SIGHT · {def.title}</p>
          <h1 class="text-display-lg text-senses-text">{def.title}</h1>
          <p class="text-senses-text-3 text-sm mt-2 max-w-lg">{def.description}</p>
        </div>
        {def.pbCount ? (
          <div class="flex-shrink-0 text-right">
            <p class="text-senses-sight text-5xl font-light leading-none tabular-nums">
              {def.pbCount.toLocaleString()}
            </p>
            <p class="text-senses-text-3 text-xs uppercase tracking-widest mt-1">items</p>
          </div>
        ) : initialItems.length > 0 && (
          <div class="flex-shrink-0 text-right">
            <p class="text-senses-sight text-5xl font-light leading-none tabular-nums">
              {initialItems.length}
            </p>
            <p class="text-senses-text-3 text-xs uppercase tracking-widest mt-1">items</p>
          </div>
        )}
      </div>
    </div>

    <!-- Grid -->
    <div class="max-w-[1440px] mx-auto px-4 md:px-8">
      {initialItems.length === 0 ? (
        <div class="py-24 text-center">
          <p class="text-senses-text-3 text-lg mb-1">No {def.title.toLowerCase()} yet</p>
          <p class="text-senses-text-3 text-sm">Check back soon — more media is on the way.</p>
        </div>
      ) : def.useLoadMore && def.chunkPath ? (
        <LoadMoreGrid
          client:load
          initialItems={initialItems}
          chunkBasePath={def.chunkPath}
          startChunk={startChunk}
          totalCount={def.pbCount}
          division="sight"
          layout={gridLayout}
        />
      ) : (
        <div class={isGridSection ? 'grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4' : 'masonry-grid'}>
          {initialItems.map(item => (
            <MediaCard client:visible media={item} layout={gridLayout} />
          ))}
        </div>
      )}
    </div>

  </div>
</BaseLayout>
