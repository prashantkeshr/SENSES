---
import BaseLayout       from '@/layouts/BaseLayout.astro';
import { MediaHero }    from '@/components/media/MediaHero';
import { MediaActions } from '@/components/media/MediaActions';
import { MediaCard }    from '@/components/media/MediaCard';
import { TypeBadge }    from '@/components/ui/Badge';
import { CommentsSection } from '@/components/social/CommentsSection';
import { PixabayTagSection } from '@/components/media/PixabayTagSection';
import { RelatedMedia }  from '@/components/media/RelatedMedia';
import { provider }     from '@/lib/providers';
import { formatCount, formatDate, formatDuration } from '@/lib/utils/formatters';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';
import type { ImageData, Creator, Media } from '@/types/index';

// ── Converters ────────────────────────────────────────────────────────────────

function pbToMedia(item: any): Media {
  const tags  = Array.isArray(item.tags) ? item.tags : [];
  const views = item.stats?.views ?? item.views ?? 0;
  const title = item.title || `Free ${item.type ?? 'photo'}`;
  const desc  = item.description || `Free high-resolution ${item.type ?? 'photo'} of ${tags.slice(0, 3).join(', ')}. Download royalty-free — no attribution required.`;
  const previewUrl = item.data?.previewUrl ?? item.thumbnail;
  const fullUrl    = item.data?.fullUrl    ?? previewUrl;
  const w = item.data?.width  ?? 640;
  const h = item.data?.height ?? 480;
  return {
    id: item.id, type: item.type as any, division: 'sight', slug: item.slug,
    title, description: desc,
    creator: item.creator ?? `px-user-${item.user_id ?? '0'}`,
    creatorName: item.creatorName ?? 'Unknown',
    creatorAvatar: item.creatorAvatar ?? '',
    thumbnail: item.thumbnail, category: item.category ?? 'nature',
    tags, moods: [], styles: [], colors: [],
    orientation: item.orientation ?? (w > h ? 'landscape' : 'portrait'),
    license: 'pixabay' as any, attribution: item.creatorName ?? '',
    source: 'pixabay', featured: false, trending: views > 50000, editorsPick: views > 100000,
    stats: { views, downloads: item.stats?.downloads ?? 0, likes: item.stats?.likes ?? 0, saves: 0 },
    createdAt: '', updatedAt: '',
    seo: { title: item.seo?.title ?? title, description: item.seo?.description ?? desc, keywords: [...tags.slice(0, 8), 'free image', 'royalty free'] },
    data: { width: w, height: h, aspectRatio: item.data?.aspectRatio ?? `${w}:${h}`, format: 'jpg', thumbnailUrl: item.thumbnail, previewUrl, fullUrl, altText: `${title} — free royalty-free download`, colors: [] },
  } as unknown as Media;
}

function pbVidToMedia(item: any): Media {
  const tags  = Array.isArray(item.tags) ? item.tags : [];
  const title = item.title || `Free Video`;
  const desc  = item.description || `Free ${item.data?.durationFmt ?? ''} ${item.videoType ?? 'video'} — "${title}". Royalty-free, no attribution needed.`;
  return {
    id: item.id, type: 'video' as any, division: 'sight', slug: item.slug,
    title, description: desc,
    creator: item.creator ?? `pvid-user-unknown`,
    creatorName: item.creatorName ?? 'Unknown',
    creatorAvatar: item.creatorAvatar ?? '',
    thumbnail: item.thumbnail ?? item.data?.thumbnail,
    category: item.category ?? 'video', tags,
    moods: [], styles: [], colors: [],
    orientation: item.orientation ?? 'landscape',
    license: 'pixabay' as any, attribution: item.creatorName ?? '',
    source: 'pixabay', featured: false,
    trending: item.trending ?? false, editorsPick: item.editorsPick ?? false,
    stats: { views: item.stats?.views ?? 0, downloads: item.stats?.downloads ?? 0, likes: item.stats?.likes ?? 0, saves: 0 },
    createdAt: '', updatedAt: '',
    seo: { title: item.seo?.title ?? title, description: item.seo?.description ?? desc, keywords: [...tags.slice(0, 8), 'free video', 'royalty free'] },
    data: item.data ?? {},
  } as unknown as Media;
}

function pb3dToMedia(item: any): Media {
  const tags  = Array.isArray(item.tags) ? item.tags : [];
  const name  = item.modelName || item.title || `3D Model`;
  const title = item.title || `${name} — Free 3D Model`;
  const desc  = item.description || `Free downloadable 3D model: ${name}. GLB format, ready for AR/VR/3D printing — no attribution required.`;
  return {
    id: item.id, type: 'model' as any, division: 'sight', slug: item.slug,
    title, description: desc,
    creator: item.creator ?? `p3d-user-unknown`,
    creatorName: item.creatorName ?? (item.data?.author ?? 'Unknown'),
    creatorAvatar: item.creatorAvatar ?? '',
    thumbnail: item.thumbnail ?? item.data?.previewUrl,
    category: item.category ?? 'objects', tags,
    moods: [], styles: [], colors: [],
    orientation: 'square',
    license: 'pixabay' as any, attribution: item.creatorName ?? '',
    source: 'pixabay', featured: false,
    trending: item.trending ?? false, editorsPick: item.editorsPick ?? false,
    stats: { views: item.stats?.views ?? 0, downloads: item.stats?.downloads ?? 0, likes: item.stats?.likes ?? 0, saves: 0 },
    createdAt: item.datePublished ?? '', updatedAt: '',
    seo: { title: item.seo?.title ?? title, description: item.seo?.description ?? desc, keywords: [...tags.slice(0, 8), '3d model', 'glb', 'free download'] },
    data: item.data ?? {},
  } as unknown as Media;
}

export async function getStaticPaths() {
  // Curated items
  const curatedMedia = await provider.getMedia({ division: 'sight' });
  const curatedPaths = curatedMedia.map((m: any) => ({
    params: { type: m.type, slug: m.slug },
    props:  { mediaId: m.id, pbItem: null as any },
  }));

  const pbMap = new Map<string, any>();
  const root  = process.cwd();

  // Pixabay images (chunks + tags)
  try {
    const chunksDir = join(root, 'public', 'data', 'pb', 'chunks');
    for (const file of readdirSync(chunksDir)) {
      if (!file.endsWith('.json')) continue;
      const items: any[] = JSON.parse(readFileSync(join(chunksDir, file), 'utf-8'));
      for (const item of items) {
        if (item.slug && !pbMap.has(item.slug)) pbMap.set(item.slug, item);
      }
    }
  } catch { /* absent */ }
  try {
    const tagsDir = join(root, 'public', 'data', 'pb', 'tags');
    for (const file of readdirSync(tagsDir)) {
      if (!file.endsWith('.json')) continue;
      const parsed = JSON.parse(readFileSync(join(tagsDir, file), 'utf-8')) as { items: any[] };
      for (const item of parsed.items) {
        if (item.slug && !pbMap.has(item.slug)) pbMap.set(item.slug, item);
      }
    }
  } catch { /* absent */ }

  // Pixabay videos (chunks)
  try {
    const vidChunksDir = join(root, 'public', 'data', 'pb', 'videos', 'chunks');
    for (const file of readdirSync(vidChunksDir)) {
      if (!file.endsWith('.json')) continue;
      const items: any[] = JSON.parse(readFileSync(join(vidChunksDir, file), 'utf-8'));
      for (const item of items) {
        if (item.slug && !pbMap.has(item.slug)) pbMap.set(item.slug, item);
      }
    }
  } catch { /* absent */ }

  // Pixabay 3D models (single all.json)
  try {
    const models: any[] = JSON.parse(readFileSync(join(root, 'public', 'data', 'pb', '3d', 'all.json'), 'utf-8'));
    for (const item of models) {
      if (item.slug && !pbMap.has(item.slug)) pbMap.set(item.slug, item);
    }
  } catch { /* absent */ }

  const pbPaths = [...pbMap.values()].map((item: any) => ({
    params: { type: item.type as string, slug: item.slug as string },
    props:  { mediaId: item.id as string, pbItem: item },
  }));

  return [...curatedPaths, ...pbPaths];
}

interface Props { mediaId: string; pbItem: any | null }
const { mediaId, pbItem } = Astro.props;

const isPb = pbItem !== null;
const mediaKind: 'image' | 'video' | 'model' =
  pbItem?.id?.startsWith('pvid-') ? 'video'
  : pbItem?.id?.startsWith('p3d-') ? 'model'
  : 'image';

let media: Media | null = null;
let creator: Creator | undefined;
let related: Media[] = [];
let crossSensory: { hearing: Media[]; sight: Media[] } = { hearing: [], sight: [] };
let moreByCreator: Media[] = [];

if (isPb) {
  if (mediaKind === 'video') media = pbVidToMedia(pbItem);
  else if (mediaKind === 'model') media = pb3dToMedia(pbItem);
  else media = pbToMedia(pbItem);
} else {
  const creators = await provider.getCreators(30);
  const creatorMap = Object.fromEntries(creators.map(c => [c.id, c]));
  const [fetchedMedia, fetchedRelated, fetchedCross] = await Promise.all([
    provider.getMediaById(mediaId),
    provider.getRelatedMedia(mediaId, 24),
    provider.getCrossSensory(mediaId),
  ]);
  if (!fetchedMedia) return Astro.redirect('/404');
  media = fetchedMedia;
  creator = creatorMap[media.creator] as Creator | undefined;
  related = fetchedRelated;
  crossSensory = fetchedCross;
  const creatorMore = await provider.getCreatorMedia(media.creator, { limit: 5 });
  moreByCreator = creatorMore.filter(m => m.id !== media!.id).slice(0, 4);
}

if (!media) return Astro.redirect('/404');

const imgData   = mediaKind === 'image' ? (media.data as ImageData) : null;
const videoData = mediaKind === 'video' ? (media.data as any)       : null;
const modelData = mediaKind === 'model' ? (media.data as any)       : null;
const ogImage   = media.thumbnail ?? imgData?.previewUrl ?? imgData?.thumbnailUrl;
const primaryTag = isPb ? (media.tags[0] ?? media.category) : '';

const licenseLabels: Record<string, string> = {
  cc0: 'CC0 Public Domain', 'cc-by': 'Creative Commons BY', 'cc-by-sa': 'Creative Commons BY-SA',
  editorial: 'Editorial Use Only', commercial: 'Commercial License',
  'senses-original': 'Senses Original', placeholder: 'Placeholder (V1)', pixabay: 'Pixabay License',
};
---

{mediaKind === 'model' && (
  <script type="module" src="https://unpkg.com/@google/model-viewer@3.5.0/dist/model-viewer.min.js" is:inline></script>
)}

{mediaKind === 'model' && (
<script type="module" is:inline>
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.min.js';
import { OrbitControls } from 'https://cdn.jsdelivr.net/npm/three@0.169.0/examples/jsm/controls/OrbitControls.js';

function initModelPage() {
  var mv        = document.getElementById('senses-model-viewer');
  var container = document.getElementById('three-container');
  var hintEl    = document.getElementById('hint-text');
  if (!container) return;

  var started = false;

  function launchThree() {
    if (started) return;
    started = true;

    if (mv) mv.style.display = 'none';
    container.classList.remove('hidden');
    container.style.display = 'block';
    if (hintEl) hintEl.textContent = 'Drag to orbit · Scroll to zoom';

    var posterSrc = container.dataset.poster || '';
    var w = container.offsetWidth  || 800;
    var h = container.offsetHeight || 600;

    var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(w, h);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;
    renderer.setClearColor(0x000000, 0);
    container.appendChild(renderer.domElement);

    var scene  = new THREE.Scene();
    var camera = new THREE.PerspectiveCamera(45, w / h, 0.1, 100);
    camera.position.set(0, 0.3, 3.8);

    var controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping  = true;
    controls.dampingFactor  = 0.06;
    controls.minDistance    = 1.5;
    controls.maxDistance    = 8;
    controls.autoRotate     = true;
    controls.autoRotateSpeed = 1.2;

    // Lighting
    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    var key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(3, 5, 4);
    scene.add(key);
    var fill = new THREE.DirectionalLight(0x8faec0, 0.7);
    fill.position.set(-4, 1, 1);
    scene.add(fill);
    var rim = new THREE.DirectionalLight(0xff2d55, 0.5);
    rim.position.set(0, -4, -3);
    scene.add(rim);

    // Thumbnail texture displayed on a 3-D gallery frame
    var texLoader = new THREE.TextureLoader();
    texLoader.load(
      posterSrc,
      function(texture) {
        var aspect = (texture.image.naturalWidth || 1) / (texture.image.naturalHeight || 1);
        var W = 2.2 * Math.min(aspect, 1.6);
        var H = 2.2 / Math.max(aspect, 0.625);
        var D = 0.14;

        var frontMat = new THREE.MeshStandardMaterial({ map: texture, roughness: 0.2, metalness: 0.1 });
        var sideMat  = new THREE.MeshStandardMaterial({ color: 0x0e0e1a, roughness: 0.5, metalness: 0.85 });
        var geo  = new THREE.BoxGeometry(W, H, D);
        // faces: +x, -x, +y, -y, +z (front), -z
        var mesh = new THREE.Mesh(geo, [sideMat, sideMat, sideMat, sideMat, frontMat, sideMat]);
        scene.add(mesh);

        // Neon edge lines
        var edges   = new THREE.EdgesGeometry(geo);
        var edgeMat = new THREE.LineBasicMaterial({ color: 0xff2d55, transparent: true, opacity: 0.35 });
        mesh.add(new THREE.LineSegments(edges, edgeMat));

        // Reflective plinth
        var pGeo = new THREE.CylinderGeometry(0.85, 1.05, 0.08, 48);
        var pMat = new THREE.MeshStandardMaterial({ color: 0x080812, roughness: 0.12, metalness: 0.96 });
        var plinth = new THREE.Mesh(pGeo, pMat);
        plinth.position.y = -(H / 2 + 0.1);
        scene.add(plinth);
      },
      undefined,
      function() {
        // Texture load failed: plain metallic slab
        var geo  = new THREE.BoxGeometry(2.2, 2.2, 0.12);
        var mat  = new THREE.MeshStandardMaterial({ color: 0x1a1a2e, roughness: 0.35, metalness: 0.8 });
        scene.add(new THREE.Mesh(geo, mat));
      }
    );

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    var ro = new ResizeObserver(function() {
      var nw = container.offsetWidth, nh = container.offsetHeight;
      if (!nw || !nh) return;
      camera.aspect = nw / nh;
      camera.updateProjectionMatrix();
      renderer.setSize(nw, nh);
    });
    ro.observe(container);
  }

  if (mv) {
    mv.addEventListener('error', launchThree);
    mv.addEventListener('load', function() {
      if (hintEl) hintEl.textContent = 'Drag to orbit · Scroll to zoom · Two-finger pan';
    });
  }
  setTimeout(function() { if (!started) launchThree(); }, 8000);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initModelPage);
} else {
  initModelPage();
}
</script>
)}

<script is:inline>
  (function() {
    var _s = null;
    function applyAmbient(c, e) {
      if (_s) { _s.remove(); _s = null; }
      if (!e || !c) return;
      var el = document.createElement('style');
      el.id = 'senses-ambient-body';
      el.textContent = 'body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse 80% 45% at 50% 0%,' + c + '18 0%,transparent 70%);transition:opacity 1s ease}';
      document.head.appendChild(el);
      _s = el;
    }
    window.addEventListener('senses:ambient', function(e) { applyAmbient(e.detail.color, e.detail.enabled); });
  })();
</script>

<BaseLayout
  title={media.seo.title}
  description={media.seo.description}
  ogImage={ogImage}
  schema={{
    "@context": "https://schema.org",
    "@graph": [
      mediaKind === 'model' ? {
        "@type": "3DModel",
        "name": media.title,
        "description": media.description,
        "thumbnailUrl": ogImage,
        "creator": isPb && media.creatorName ? { "@type": "Person", "name": media.creatorName } : undefined,
      } : mediaKind === 'video' ? {
        "@type": "VideoObject",
        "name": media.title,
        "description": media.description,
        "thumbnailUrl": ogImage,
        "duration": videoData?.duration ? `PT${Math.floor(videoData.duration)}S` : undefined,
        "creator": isPb && media.creatorName ? { "@type": "Person", "name": media.creatorName } : undefined,
      } : {
        "@type": "ImageObject",
        "name": media.title,
        "description": media.description,
        "contentUrl": ogImage,
        "creator": isPb && media.creatorName ? { "@type": "Person", "name": media.creatorName } : creator ? { "@type": "Person", "name": creator.displayName } : undefined,
        "license": "https://pixabay.com/service/license-summary/",
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Senses", "item": "https://senses.dhurta.org" },
          { "@type": "ListItem", "position": 2, "name": "SIGHT",  "item": "https://senses.dhurta.org/sight" },
          { "@type": "ListItem", "position": 3, "name": media.type.charAt(0).toUpperCase() + media.type.slice(1), "item": `https://senses.dhurta.org/sight/${media.type}` },
          { "@type": "ListItem", "position": 4, "name": media.title },
        ],
      },
    ],
  }}
>
  <div class="pt-[var(--nav-height)] pb-20">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-xs text-senses-text-3 py-5 flex-wrap" aria-label="Breadcrumb">
        <a href="/" class="hover:text-senses-text transition-colors">Senses</a>
        <span>/</span>
        <a href="/sight" class="text-senses-sight hover:text-senses-text transition-colors">SIGHT</a>
        <span>/</span>
        <span class="capitalize">{media.type}</span>
        <span>/</span>
        <span class="text-senses-text truncate max-w-[200px]">{media.title}</span>
      </nav>

      <!-- ── VIDEO PLAYER ──────────────────────────────────────────────────── -->
      {mediaKind === 'video' && videoData && (
        <div class="mb-6 rounded-xl overflow-hidden bg-black aspect-video shadow-xl shadow-black/50">
          <video
            controls
            preload="metadata"
            poster={videoData.thumbnail ?? media.thumbnail}
            class="w-full h-full object-contain"
            aria-label={media.title}
          >
            {videoData.streamUrl && <source src={videoData.streamUrl} type="video/mp4" />}
            {videoData.fullUrl && videoData.fullUrl !== videoData.streamUrl && <source src={videoData.fullUrl} type="video/mp4" />}
            Your browser does not support HTML5 video.
          </video>
        </div>
      )}

      <!-- ── 3D MODEL VIEWER ────────────────────────────────────────────────── -->
      {mediaKind === 'model' && modelData && (
        <div id="model-viewer-wrap" class="mb-6 rounded-xl overflow-hidden bg-senses-surface border border-senses-border shadow-xl shadow-black/30">
          <div class="relative" style="height: min(75vh, 600px);">
            <!-- model-viewer: works when CDN allows GLB access -->
            <model-viewer
              id="senses-model-viewer"
              src={modelData.modelUrl}
              poster={modelData.previewUrl ?? media.thumbnail}
              alt={media.title}
              ar
              auto-rotate
              camera-controls
              shadow-intensity="1"
              exposure="1"
              environment-image="neutral"
              style="width:100%;height:100%;background:transparent;"
            ></model-viewer>

            <!-- Hint overlay — updated by script when model loads/fails -->
            <div id="model-hint" class="absolute bottom-3 left-1/2 -translate-x-1/2 pointer-events-none z-10">
              <div class="flex items-center gap-3 px-3 py-1.5 rounded-full bg-black/50 backdrop-blur-sm border border-white/10 text-white/60 text-[10px]">
                <span id="hint-text">Loading 3D model…</span>
              </div>
            </div>

            <!-- Three.js WebGL 3D fallback (real orbit + zoom + lighting) -->
            <div
              id="three-container"
              data-poster={modelData.previewUrl ?? media.thumbnail}
              class="absolute inset-0 hidden"
            ></div>
          </div>
        </div>
      )}

      <!-- ── IMAGE HERO ─────────────────────────────────────────────────────── -->
      {mediaKind === 'image' && (
        <div class="mb-6 rounded-xl overflow-hidden" style="touch-action: pinch-zoom;">
          <MediaHero client:load media={media} />
        </div>
      )}

      <!-- Title + Actions -->
      <div class="flex flex-col gap-4 mb-10 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <div class="flex items-center gap-2 mb-2 flex-wrap">
            <TypeBadge type={media.type} division="sight" />
            <span class="text-senses-sight text-xs tracking-widest font-medium uppercase">Sight</span>
            {media.editorsPick && (
              <span class="text-[10px] px-2 py-0.5 rounded border border-senses-sight/30 text-senses-sight/80 tracking-widest uppercase">
                Editor's Pick
              </span>
            )}
            {mediaKind === 'video' && videoData?.videoType && (
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-senses-surface border border-senses-border text-senses-text-3 capitalize">
                {videoData.videoType}
              </span>
            )}
            {mediaKind === 'model' && (
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-senses-surface border border-senses-border text-senses-text-3">
                GLB / 3D
              </span>
            )}
          </div>
          <h1 class="text-display-lg text-senses-text leading-tight mb-1">{media.title}</h1>
          {isPb ? (
            <p class="text-senses-text-3 text-sm">
              by <span class="text-senses-text-2">{media.creatorName || 'Unknown'}</span>
            </p>
          ) : creator && (
            <p class="text-senses-text-3 text-sm">
              by <a href={`/creator/${creator.id}`} class="text-senses-text-2 hover:text-senses-text transition-colors">{creator.displayName}</a>
            </p>
          )}
        </div>
        <div class="flex-shrink-0">
          <MediaActions client:load media={media} />
        </div>
      </div>

      <!-- Main 2-col layout -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-14">

        <!-- Left: description + metadata -->
        <div class="lg:col-span-2 space-y-8">

          <!-- Description -->
          <section>
            <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">About</h2>
            <p class="text-senses-text-2 leading-relaxed text-base">{media.description}</p>
          </section>

          <!-- Tags -->
          {media.tags.length > 0 && (
            <section>
              <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">Tags</h2>
              <div class="flex flex-wrap gap-1.5">
                {media.tags.slice(0, 25).map(tag => (
                  <a href={`/tag/${encodeURIComponent(tag)}`}
                    class="px-2.5 py-1 rounded-lg text-xs bg-senses-surface border border-senses-border text-senses-text-3 hover:border-senses-border-2 hover:text-senses-text-2 transition-all capitalize"
                  >{tag}</a>
                ))}
              </div>
            </section>
          )}

          <!-- Moods + Styles (curated only) -->
          {!isPb && (media.moods.length > 0 || media.styles.length > 0) && (
            <section class="grid grid-cols-2 gap-6">
              {media.moods.length > 0 && (
                <div>
                  <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">Mood</h2>
                  <div class="flex flex-wrap gap-1.5">
                    {media.moods.map(m => (
                      <a href={`/mood/${m}`} class="px-2.5 py-1 rounded-lg text-xs bg-senses-sight/10 border border-senses-sight/20 text-senses-sight/90 capitalize hover:border-senses-sight/50 hover:text-senses-sight transition-all">{m}</a>
                    ))}
                  </div>
                </div>
              )}
              {media.styles.length > 0 && (
                <div>
                  <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">Style</h2>
                  <div class="flex flex-wrap gap-1.5">
                    {media.styles.map(s => (
                      <a href={`/style/${s}`} class="px-2.5 py-1 rounded-lg text-xs bg-senses-surface-2 border border-senses-border text-senses-text-3 capitalize hover:border-senses-border-2 hover:text-senses-text-2 transition-all">{s.replace(/-/g,' ')}</a>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )}

          <!-- Technical info -->
          <section>
            <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">Technical</h2>
            <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-3">
              {mediaKind === 'image' && imgData && [
                ['Dimensions',   `${imgData.width} × ${imgData.height}`],
                ['Aspect Ratio', String(imgData.aspectRatio ?? (imgData.width && imgData.height ? (imgData.width / imgData.height).toFixed(2) : '—'))],
                ['Format',       imgData.format ?? 'jpg'],
                ['Orientation',  media.orientation ?? '—'],
              ].map(([label, value]) => (
                <div>
                  <dt class="text-senses-text-3 text-[10px] uppercase tracking-wider mb-0.5">{label}</dt>
                  <dd class="text-senses-text-2 text-sm font-mono capitalize">{value}</dd>
                </div>
              ))}
              {mediaKind === 'video' && videoData && [
                ['Duration',   videoData.durationFmt ?? (videoData.duration ? formatDuration(videoData.duration) : '—')],
                ['Resolution', videoData.width && videoData.height ? `${videoData.width} × ${videoData.height}` : '—'],
                ['Format',     videoData.format ?? 'mp4'],
                ['Type',       (videoData.videoType ?? pbItem?.videoType ?? '—')],
              ].map(([label, value]) => (
                <div>
                  <dt class="text-senses-text-3 text-[10px] uppercase tracking-wider mb-0.5">{label}</dt>
                  <dd class="text-senses-text-2 text-sm font-mono capitalize">{value}</dd>
                </div>
              ))}
              {mediaKind === 'model' && modelData && [
                ['Format',    'GLB'],
                ['Category',  media.category],
                ['Published', pbItem?.datePublished ? new Date(pbItem.datePublished).getFullYear().toString() : '—'],
              ].map(([label, value]) => (
                <div>
                  <dt class="text-senses-text-3 text-[10px] uppercase tracking-wider mb-0.5">{label}</dt>
                  <dd class="text-senses-text-2 text-sm font-mono capitalize">{value}</dd>
                </div>
              ))}
            </dl>
          </section>

          <!-- Category link -->
          {media.category && (
            <section>
              <h2 class="text-senses-text-3 text-xs tracking-widest uppercase mb-3 font-medium">Category</h2>
              <a href={`/category/${media.category}`}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm bg-senses-surface border border-senses-border text-senses-text-2 hover:border-senses-sight/40 hover:text-senses-sight capitalize transition-all"
              >{media.category}</a>
            </section>
          )}
        </div>

        <!-- Right sidebar -->
        <div class="space-y-4">

          <!-- Curated creator card -->
          {!isPb && creator && (
            <div class="rounded-xl bg-senses-surface border border-senses-border p-4">
              <div class="flex items-center gap-3 mb-3">
                <img src={creator.avatar} alt={creator.displayName} class="w-10 h-10 rounded-full object-cover bg-senses-surface-2" />
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="text-senses-text text-sm font-medium truncate">{creator.displayName}</span>
                    {creator.verified && (
                      <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-senses-hearing flex-shrink-0">
                        <path fill-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0 1 12 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 0 1 3.498 1.307 4.491 4.491 0 0 1 1.307 3.497A4.49 4.49 0 0 1 21.75 12a4.49 4.49 0 0 1-1.549 3.397 4.491 4.491 0 0 1-1.307 3.497 4.491 4.491 0 0 1-3.497 1.307A4.49 4.49 0 0 1 12 21.75a4.49 4.49 0 0 1-3.397-1.549 4.491 4.491 0 0 1-3.497-1.307 4.491 4.491 0 0 1-1.307-3.497A4.49 4.49 0 0 1 2.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 0 1 1.307-3.497 4.49 4.49 0 0 1 3.497-1.307Zm7.007 6.387a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd"/>
                      </svg>
                    )}
                  </div>
                  <span class="text-senses-text-3 text-xs">@{creator.username}</span>
                </div>
              </div>
              <p class="text-senses-text-3 text-xs leading-relaxed mb-3 line-clamp-2">{creator.bio}</p>
              <div class="grid grid-cols-3 gap-2 text-center mb-3">
                {[[formatCount(creator.stats.mediaCount), 'Works'], [formatCount(creator.stats.followers), 'Followers'], [formatCount(creator.stats.totalViews), 'Views']].map(([val, lbl]) => (
                  <div>
                    <p class="text-senses-text text-sm font-medium">{val}</p>
                    <p class="text-senses-text-3 text-[10px]">{lbl}</p>
                  </div>
                ))}
              </div>
              <a href={`/creator/${creator.id}`} class="block text-center text-xs py-2 rounded-lg bg-senses-surface-2 border border-senses-border text-senses-text-2 hover:border-senses-border-2 hover:text-senses-text transition-all">
                View Profile
              </a>
            </div>
          )}

          <!-- Pixabay creator chip -->
          {isPb && media.creatorName && (
            <div class="rounded-xl bg-senses-surface border border-senses-border p-4">
              <div class="flex items-center gap-3">
                {media.creatorAvatar ? (
                  <img src={media.creatorAvatar} alt={media.creatorName} class="w-10 h-10 rounded-full object-cover bg-senses-surface-2" />
                ) : (
                  <div class="w-10 h-10 rounded-full bg-senses-surface-2 flex items-center justify-center text-senses-text-3 text-sm font-medium">
                    {(media.creatorName as string)[0].toUpperCase()}
                  </div>
                )}
                <div>
                  <p class="text-senses-text text-sm font-medium">{media.creatorName}</p>
                  <p class="text-senses-text-3 text-xs capitalize">
                    {mediaKind === 'video' ? 'Video Creator' : mediaKind === 'model' ? '3D Artist' : 'Photographer'}
                  </p>
                </div>
              </div>
            </div>
          )}

          <!-- Stats -->
          <div class="rounded-xl bg-senses-surface border border-senses-border p-4">
            <h3 class="text-senses-text-3 text-[10px] uppercase tracking-widest mb-3">Stats</h3>
            <div class="space-y-2">
              {[
                [mediaKind === 'video' ? 'Plays' : 'Views',  formatCount(media.stats.views)],
                ['Likes',     formatCount(media.stats.likes)],
                ['Downloads', formatCount(media.stats.downloads)],
              ].map(([lbl, val]) => (
                <div class="flex justify-between items-center">
                  <span class="text-senses-text-3 text-xs">{lbl}</span>
                  <span class="text-senses-text-2 text-sm font-medium tabular-nums">{val}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- License -->
          <div class="rounded-xl bg-senses-surface border border-senses-border p-4">
            <h3 class="text-senses-text-3 text-[10px] uppercase tracking-widest mb-2">License</h3>
            <p class="text-senses-text-2 text-sm font-medium mb-1">{licenseLabels[media.license] ?? media.license}</p>
            <p class="text-senses-text-3 text-xs leading-relaxed">
              {media.license === 'pixabay' ? 'Free for personal and commercial use. No attribution required.'
               : media.license === 'cc0'   ? 'Free for any use, no attribution required.'
               : 'Check license details before use.'}
            </p>
          </div>

          <!-- Pixabay source icon (no link, per design constraints) -->
          {isPb && (
            <div class="rounded-xl bg-senses-surface border border-senses-border p-4 flex items-center gap-3">
              <svg viewBox="0 0 48 48" class="w-7 h-7 flex-shrink-0" aria-label="Pixabay">
                <circle cx="24" cy="24" r="24" fill="#1DA462"/>
                <path d="M18.5 14h4.2l2.3 6.2 2.3-6.2h4.2l-4.5 10.1 4.8 9.9h-4.2l-2.6-6.7-2.6 6.7h-4.2l4.8-9.9z" fill="#fff"/>
              </svg>
              <div>
                <p class="text-senses-text-2 text-xs font-medium">Pixabay</p>
                <p class="text-senses-text-3 text-[10px]">
                  {mediaKind === 'video' ? 'Video source' : mediaKind === 'model' ? '3D model source' : 'Image source'}
                </p>
              </div>
            </div>
          )}

          {!isPb && media.createdAt && (
            <p class="text-senses-text-3 text-xs px-1">Published {formatDate(media.createdAt)}</p>
          )}
        </div>
      </div>

      <!-- Cross-sensory (curated only) -->
      {!isPb && crossSensory.hearing.length > 0 && (
        <section class="mb-14">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex-1 h-px bg-senses-border" />
            <h2 class="text-sm font-medium whitespace-nowrap">
              <span class="text-senses-text-3">Pair with</span>
              <span class="text-senses-hearing ml-1.5 tracking-widest uppercase text-xs">Hearing</span>
            </h2>
            <div class="flex-1 h-px bg-senses-border" />
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
            {crossSensory.hearing.map(item => (
              <MediaCard client:visible media={item} layout="grid" />
            ))}
          </div>
        </section>
      )}

      <!-- More by creator (curated only) -->
      {!isPb && moreByCreator.length > 0 && creator && (
        <section class="mb-14">
          <div class="flex items-center justify-between mb-5">
            <h2 class="text-senses-text text-sm font-medium">More by <span class="text-senses-sight">{creator.displayName}</span></h2>
            <a href={`/creator/${creator.id}`} class="text-senses-text-3 hover:text-senses-text text-xs transition-colors">View all →</a>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
            {moreByCreator.map(item => (
              <MediaCard client:visible media={item} creator={creator} layout="grid" />
            ))}
          </div>
        </section>
      )}

      <!-- Related (curated only) -->
      {!isPb && related.length > 0 && (
        <section class="mb-14">
          <h2 class="text-senses-text text-sm font-medium mb-5">Related <span class="text-senses-sight capitalize">{media.category}</span> media</h2>
          <div class="masonry-grid">
            {related.slice(0, 12).map(item => (
              <MediaCard client:visible media={item} />
            ))}
          </div>
        </section>
      )}

      <!-- More from same tag (Pixabay images only) -->
      {isPb && mediaKind === 'image' && primaryTag && (
        <section class="mb-14">
          <h2 class="text-senses-text text-sm font-medium mb-5">More free <span class="text-senses-sight capitalize">{primaryTag}</span> images</h2>
          <PixabayTagSection tagSlug={primaryTag} tagLabel={primaryTag} client:visible />
        </section>
      )}

      <!-- Related from Pixabay chunks -->
      {isPb && mediaKind !== 'model' && (
        <RelatedMedia
          client:visible
          currentId={media.id}
          division="sight"
          category={media.category}
          chunkPath={mediaKind === 'video' ? '/data/pb/videos/chunks/' : '/data/pb/chunks/'}
          chunkCount={50}
          label={mediaKind === 'video' ? 'More Videos' : 'More Photos'}
        />
      )}

      <!-- Comments -->
      <CommentsSection client:visible mediaId={media.id} division="sight" />

    </div>
  </div>
</BaseLayout>
